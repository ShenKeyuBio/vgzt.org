{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vgzt-contact",
  "account_id": "fd4eb20c16040711048e738d0445e38b",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "api.vgzt.org",
      "custom_domain": true,
    },
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://vgzt.org,https://www.vgzt.org",
    "TURNSTILE_EXPECTED_HOSTNAMES": "vgzt.org,www.vgzt.org",
    "TURNSTILE_EXPECTED_ACTION": "vgzt_contact",
    "TURNSTILE_JOIN_EXPECTED_ACTION": "vgzt_join",
    "CONTACT_FROM": "contact@vgzt.org",
    "EMAILOCTOPUS_LIST_ID": "185d52da-9822-11f1-a2d9-c12234517e31",
  },
  "secrets": {
    "required": [
      "TURNSTILE_SECRET",
      "CONTACT_TO",
      "SLACK_WEBHOOK_URL",
      "EMAILOCTOPUS_API_KEY",
      "SLACK_INVITE_URL",
    ],
  },
  "ratelimits": [
    {
      "name": "CONTACT_IP_RATE",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
    {
      "name": "CONTACT_EMAIL_RATE",
      "namespace_id": "1002",
      "simple": {
        "limit": 3,
        "period": 60,
      },
    },
  ],
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "allowed_sender_addresses": ["contact@vgzt.org"],
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
