---
import { Image } from 'astro:assets';
import turingTexture from '../assets/brand/turing-historical-reference.png';
import BrandMark from './BrandMark.astro';

interface Props {
  seasonNumber: number;
  seasonLabel: string;
  seasonDates: string;
  description: string;
  abstractUrl?: string | null;
  abstractLabel?: string | null;
  abstractExternal?: boolean;
  masterLogo?: string | null;
  expectedSpeakerCount?: number;
  expectedSpeakerUrl?: string;
}

const {
  seasonNumber,
  seasonLabel,
  seasonDates,
  description,
  abstractUrl = null,
  abstractLabel = null,
  abstractExternal = false,
  masterLogo = null,
  expectedSpeakerCount = 0,
  expectedSpeakerUrl = '#speaker-preview',
} = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <Image
    class="hero__texture"
    src={turingTexture}
    alt=""
    aria-hidden="true"
    widths={[768, 1280, 1920]}
    sizes="100vw"
    format="webp"
    loading="eager"
    fetchpriority="high"
    data-visual-source="historical-vgzt-reaction-diffusion-reference"
  />
  <div class="hero__inner container">
    <div class="hero__copy">
      <p class="hero__season">
        <strong>{seasonLabel}</strong>
        <span class="hero__season-divider" aria-hidden="true">·</span>
        <span class="hero__season-dates">{seasonDates}</span>
      </p>
      <h1 id="hero-title">Virtual<br />Gastrulation<br />Zoom Talks</h1>
      <p class="hero__intro">{description}</p>
      <div class="button-row">
        {
          abstractUrl && abstractLabel ? (
            <a
              class="button button--ink"
              href={abstractUrl}
              rel={abstractExternal ? 'noopener noreferrer' : undefined}
              target={abstractExternal ? '_blank' : undefined}
              data-submit-source
            >
              {abstractLabel}
            </a>
          ) : null
        }
        <a class="button" href="/subscribe/">Subscribe VGZT Talks</a>
      </div>
      {
        expectedSpeakerCount > 0 ? (
          <a class="hero__speaker-signal" href={expectedSpeakerUrl}>
            {expectedSpeakerCount} researchers currently expected for{' '}
            {seasonLabel}
            <span aria-hidden="true"> · View expected speakers →</span>
          </a>
        ) : null
      }
    </div>

    <div class="hero__mark" aria-hidden={masterLogo ? undefined : 'true'}>
      <BrandMark masterLogo={masterLogo} seasonNumber={seasonNumber} />
    </div>
  </div>
</section>

<style>
  .hero__speaker-signal {
    display: inline-block;
    max-width: 34rem;
    margin-top: 1rem;
    font-size: 0.9rem;
    font-weight: 850;
  }
</style>
