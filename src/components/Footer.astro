---
import { Image } from 'astro:assets';
import turingTexture from '../assets/brand/turing-historical-reference.png';
import BrandMark from './BrandMark.astro';
import SocialLinks from './SocialLinks.astro';

interface SocialItem {
  label: string;
  url?: string | null;
  external?: boolean;
}

interface Props {
  email: string;
  social: SocialItem[];
  masterLogo?: string | null;
  seasonNumber?: number | null;
}

const { email, social, masterLogo = null, seasonNumber = null } = Astro.props;
const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <Image
    class="site-footer__texture"
    src={turingTexture}
    alt=""
    aria-hidden="true"
    widths={[768, 1280]}
    sizes="100vw"
    format="webp"
    loading="lazy"
  />
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <BrandMark
          masterLogo={masterLogo}
          colourDots
          seasonNumber={seasonNumber}
        />
        <p>
          Virtual Gastrulation Zoom Talks connects the developmental-biology
          community worldwide.
        </p>
      </div>
      <div class="site-footer__actions">
        <div>
          <p class="eyebrow">Stay connected</p>
          <SocialLinks items={social} />
        </div>
        <a href={`mailto:${email}`}>{email}</a>
      </div>
    </div>
    <div class="site-footer__bottom">
      <span>© {year} Virtual Gastrulation Zoom Talks</span>
      <span class="maker-watermark">Website by Keyu Shen</span>
      <ul class="footer-links">
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/subscribe/">Subscribe VGZT Talks</a></li>
      </ul>
    </div>
  </div>
</footer>
