---
interface Props {
  masterLogo?: string | null;
  colourDots?: boolean;
  seasonNumber?: number | null;
  label?: string;
  class?: string;
}

const {
  masterLogo = null,
  label = 'Virtual Gastrulation Zoom Talks',
  class: className = '',
} = Astro.props;
const logoSrc = masterLogo || '/brand/vgzt-logo.png';
---

<img
  class:list={['brand-logo', className]}
  src={logoSrc}
  alt={label}
  width="1133"
  height="1388"
  decoding="async"
/>

<style>
  .brand-logo {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
  }
</style>
