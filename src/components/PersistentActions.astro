---
import type { AbstractCallState } from '../lib/config';

interface Props {
  abstractState: AbstractCallState;
}

const { abstractState } = Astro.props;
const showSubmit = abstractState.canSubmit && Boolean(abstractState.ctaUrl);
---

<nav class="persistent-actions" aria-label="Quick actions">
  <div class="persistent-actions__desktop" data-persistent-desktop-actions>
    {
      showSubmit ? (
        <a
          class="button button--pink"
          href={abstractState.ctaUrl ?? '/abstracts/'}
        >
          Submit an abstract
        </a>
      ) : null
    }
    <a class="button" href="/subscribe/">Subscribe</a>
  </div>

  <div
    class:list={[
      'persistent-actions__mobile',
      { 'persistent-actions__mobile--single': !showSubmit },
    ]}
    data-persistent-mobile-actions
  >
    {
      showSubmit ? (
        <a
          class="button button--pink"
          href={abstractState.ctaUrl ?? '/abstracts/'}
          data-persistent-submit
        >
          Submit abstract
        </a>
      ) : null
    }
    <a class="button" href="/subscribe/">Subscribe</a>
  </div>
</nav>

<style>
  .persistent-actions__desktop {
    position: fixed;
    z-index: 25;
    top: 50%;
    right: max(1rem, env(safe-area-inset-right));
    display: grid;
    width: 7rem;
    grid-template-columns: repeat(2, var(--tap-target));
    padding: 0.65rem;
    transform: translateY(-50%);
    border: var(--keyline);
    background: var(--vgzt-paper);
    gap: 0.45rem;
    align-content: center;
    justify-content: center;
    box-shadow: -0.45rem 0.45rem 0 rgb(11 11 11 / 9%);
  }

  .persistent-actions__desktop .button {
    min-width: var(--tap-target);
    min-height: 8.75rem;
    padding: 0.65rem;
    font-size: var(--font-ui-small);
    line-height: 1.15;
    writing-mode: vertical-rl;
  }

  .persistent-actions__desktop .button:hover {
    transform: none;
  }

  .persistent-actions__mobile {
    display: none;
  }

  .persistent-actions [hidden] {
    display: none;
  }

  @media (max-width: 56rem) {
    :global(body) {
      padding-bottom: calc(5rem + env(safe-area-inset-bottom));
    }

    .persistent-actions__desktop {
      display: none;
    }

    .persistent-actions__mobile {
      position: fixed;
      z-index: 25;
      right: 0;
      bottom: 0;
      left: 0;
      display: grid;
      padding: 0.55rem max(0.625rem, env(safe-area-inset-right))
        calc(0.55rem + env(safe-area-inset-bottom))
        max(0.625rem, env(safe-area-inset-left));
      border-top: 2px solid var(--vgzt-paper-strong);
      background: var(--vgzt-ink);
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.55rem;
      transition: transform 120ms ease;
    }

    .persistent-actions__mobile--single {
      grid-template-columns: 1fr;
    }

    .persistent-actions__mobile .button {
      min-height: 3.25rem;
      padding-inline: 0.75rem;
    }

    .persistent-actions__mobile[data-form-focus='true'] {
      pointer-events: none;
      transform: translateY(110%);
    }
  }

  @media print {
    .persistent-actions {
      display: none;
    }

    :global(body) {
      padding-bottom: 0;
    }
  }
</style>

<script>
  const mobileActions = document.querySelector<HTMLElement>(
    '[data-persistent-mobile-actions]',
  );
  if (mobileActions) {
    const formControl =
      'input:not([type="hidden"]), select, textarea, [contenteditable="true"], [role="status"][tabindex="-1"], [data-subscription-result][tabindex="-1"]';
    const updateSafety = () => {
      const focused = document.activeElement?.matches(formControl) ?? false;
      const keyboardOpen = Boolean(
        window.visualViewport &&
        window.visualViewport.height < window.innerHeight * 0.76,
      );
      mobileActions.dataset.formFocus = String(focused || keyboardOpen);
    };
    document.addEventListener('focusin', updateSafety);
    document.addEventListener('focusout', () =>
      requestAnimationFrame(updateSafety),
    );
    window.visualViewport?.addEventListener('resize', updateSafety);
    updateSafety();
  }
</script>
