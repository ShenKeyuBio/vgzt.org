---
interface Props {
  id: string;
  name: string;
  preferredName?: string | null;
  affiliation?: string | null;
}

const { id, name, preferredName = null, affiliation = null } = Astro.props;
const displayName = preferredName || name;
---

<article class="speaker-archive-card" data-person-id={id}>
  <h3>{displayName}</h3>
  {affiliation && <p>{affiliation}</p>}
</article>

<style>
  .speaker-archive-card {
    display: grid;
    min-width: 0;
    min-height: 7rem;
    padding: 1.05rem;
    border: var(--keyline);
    background: var(--vgzt-paper-strong);
    align-content: start;
  }

  h3 {
    margin-bottom: 0.5rem;
    font-size: clamp(1.35rem, 2.4vw, 1.8rem);
    line-height: 1.02;
  }

  p {
    margin: 0;
    overflow-wrap: anywhere;
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1.35;
  }
</style>
