---
import BrandMark from './BrandMark.astro';
import MobileNav from './MobileNav.astro';

interface Props {
  masterLogo?: string | null;
  seasonNumber?: number | null;
  currentPath?: string;
}

const {
  masterLogo = null,
  seasonNumber = null,
  currentPath = '/',
} = Astro.props;
const navigation = [
  { label: 'Schedule', href: '/#programme' },
  { label: 'Abstracts', href: '/abstracts/' },
  { label: 'Opportunities', href: '/opportunities/' },
  { label: 'People', href: '/people/' },
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
];
const isCurrent = (href: string) => {
  const path = href.split('#')[0] || '/';
  return path === '/'
    ? currentPath === '/' || currentPath.startsWith('/events/')
    : currentPath === path;
};
---

<header class="site-header">
  <div class="site-header__inner container">
    <a class="site-header__brand" href="/" aria-label="VGZT home">
      <BrandMark
        masterLogo={masterLogo}
        colourDots
        seasonNumber={seasonNumber}
      />
    </a>

    <nav class="site-header__nav" aria-label="Primary navigation">
      <ul>
        {
          navigation.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      class="button site-header__join"
      href="/subscribe/"
      aria-current={currentPath === '/subscribe/' ? 'page' : undefined}
    >
      Subscribe VGZT Talks
    </a>
    <MobileNav items={navigation} currentPath={currentPath} />
  </div>
</header>
