---
interface PreviewSpeaker {
  name: string;
  affiliation: string;
}

interface Props {
  disclaimer: string;
  speakers: PreviewSpeaker[];
}

const { disclaimer, speakers } = Astro.props;
const orderedSpeakers = [...speakers].sort((a, b) =>
  a.name.localeCompare(b.name, 'en', { sensitivity: 'base' }),
);
---

<section
  id="speaker-preview"
  class="section section--pink speaker-preview"
  aria-labelledby="speaker-preview-title"
>
  <div class="container">
    <div class="section-heading speaker-preview__heading">
      <div>
        <p class="eyebrow">Expected for Season 8</p>
        <h2 id="speaker-preview-title">Season 8 Speaker Preview</h2>
      </div>
      <p class="speaker-preview__disclaimer">{disclaimer}</p>
    </div>

    <div class="speaker-preview__grid">
      {
        orderedSpeakers.map((speaker) => (
          <article class="speaker-preview__card">
            <h3>{speaker.name}</h3>
            <p>{speaker.affiliation}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .speaker-preview__heading {
    align-items: start;
  }

  .speaker-preview__heading h2 {
    max-width: 12ch;
  }

  .speaker-preview__disclaimer {
    max-width: 43rem;
    font-size: clamp(1rem, 1.7vw, 1.2rem);
    font-weight: 850;
    line-height: 1.45;
  }

  .speaker-preview__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .speaker-preview__card {
    display: grid;
    min-width: 0;
    min-height: 6.5rem;
    padding: 0.9rem;
    border: var(--keyline);
    background: var(--vgzt-paper-strong);
    align-content: start;
  }

  .speaker-preview__card:nth-child(4n + 2) {
    border-top-color: var(--vgzt-blue);
  }

  .speaker-preview__card:nth-child(4n + 3) {
    border-top-color: var(--vgzt-cyan);
  }

  .speaker-preview__card:nth-child(4n + 4) {
    border-top-color: var(--vgzt-orange);
  }

  .speaker-preview__card h3 {
    margin-bottom: 0.45rem;
    font-size: clamp(1.08rem, 1.5vw, 1.4rem);
    line-height: 1.08;
  }

  .speaker-preview__card p {
    margin: 0;
    overflow-wrap: anywhere;
    font-size: 0.84rem;
    font-weight: 700;
    line-height: 1.35;
  }

  @media (max-width: 70rem) {
    .speaker-preview__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 42rem) {
    .speaker-preview__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .speaker-preview__card {
      min-height: 0;
    }
  }

  @media (max-width: 24rem) {
    .speaker-preview__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
