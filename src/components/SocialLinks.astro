---
interface SocialItem {
  label: string;
  url?: string | null;
  external?: boolean;
}

interface Props {
  items: SocialItem[];
}

const { items } = Astro.props;
---

<ul class="social-list" aria-label="VGZT social links">
  {
    items.map((item) => (
      <li>
        {item.url ? (
          <a
            href={item.url}
            rel={item.external ? 'noopener noreferrer' : undefined}
            target={item.external ? '_blank' : undefined}
          >
            {item.label}
            {item.external && (
              <span class="visually-hidden"> (opens in a new tab)</span>
            )}
          </a>
        ) : (
          <span aria-disabled="true" title={`${item.label} link coming soon`}>
            {item.label}
          </span>
        )}
      </li>
    ))
  }
</ul>
