---
interface Props {
  endpoint?: string | null;
  turnstileSiteKey?: string | null;
  email: string;
}

const { endpoint = null, turnstileSiteKey = null, email } = Astro.props;
const enabled = Boolean(endpoint && turnstileSiteKey);
const categories = [
  { value: 'general', label: 'General' },
  { value: 'speaker-abstract', label: 'Speaker / abstract' },
  { value: 'opportunity', label: 'Opportunity' },
  { value: 'technical', label: 'Technical website issue' },
  { value: 'other', label: 'Other' },
];
---

<section class="contact-section" id="contact" aria-labelledby="contact-title">
  <div class="container contact-section__grid">
    <div class="contact-section__intro">
      <p class="eyebrow">Contact the organizers</p>
      <h2 id="contact-title">Let’s keep the conversation moving.</h2>
      <p>
        Questions about a seminar, abstract, community notice, or the website?
        Send the organizer team a note.
      </p>
      <a href={`mailto:${email}`}>{email}</a>
    </div>

    <form
      class="contact-form"
      method="post"
      action={endpoint || undefined}
      data-contact-form
      data-endpoint={endpoint || ''}
      data-enabled={String(enabled)}
      novalidate
    >
      <div class="contact-form__row">
        <div class="field">
          <label for="contact-name">Name</label>
          <input
            id="contact-name"
            name="name"
            autocomplete="name"
            required
            maxlength="100"
          />
          <span class="field__error" id="contact-name-error"></span>
        </div>
        <div class="field">
          <label for="contact-email">Email</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="email"
            required
            maxlength="254"
          />
          <span class="field__error" id="contact-email-error"></span>
        </div>
      </div>

      <div class="field">
        <label for="contact-category">Subject</label>
        <select id="contact-category" name="category" required>
          {
            categories.map((category) => (
              <option value={category.value}>{category.label}</option>
            ))
          }
        </select>
        <span class="field__error" id="contact-category-error"></span>
      </div>

      <div class="field">
        <label for="contact-message">Message</label>
        <textarea
          id="contact-message"
          name="message"
          rows="7"
          required
          minlength="10"
          maxlength="5000"></textarea>
        <span class="field__meta"
          ><span>10–5,000 characters</span><span data-message-count>0</span
          ></span
        >
        <span class="field__error" id="contact-message-error"></span>
      </div>

      <div class="field field--honeypot" aria-hidden="true">
        <label for="contact-website">Website</label>
        <input
          id="contact-website"
          name="website"
          tabindex="-1"
          autocomplete="off"
        />
      </div>

      <label class="privacy-check" for="contact-privacy">
        <input
          id="contact-privacy"
          name="privacyAccepted"
          type="checkbox"
          required
          value="true"
        />
        <span
          >I agree that VGZT may use these details to reply to this message. See
          the <a href="/privacy/">privacy notice</a>.</span
        >
      </label>
      <span class="field__error" id="contact-privacy-error"></span>

      {
        turnstileSiteKey && (
          <div
            class="cf-turnstile"
            data-sitekey={turnstileSiteKey}
            data-action="vgzt_contact"
            data-callback="vgztTurnstileComplete"
            data-expired-callback="vgztTurnstileExpired"
            data-error-callback="vgztTurnstileExpired"
          />
        )
      }

      {
        !enabled && (
          <p class="contact-form__unavailable" role="status">
            The secure web form is being connected. In the meantime, email{' '}
            <a href={`mailto:${email}`}>{email}</a>.
          </p>
        )
      }

      <div class="contact-form__submit-row">
        <button class="button button--ink" type="submit" disabled={!enabled}>
          Send message <span aria-hidden="true">→</span>
        </button>
        <p
          class="contact-form__status"
          role="status"
          aria-live="polite"
          data-form-status
        >
        </p>
      </div>
    </form>
  </div>
</section>

{
  turnstileSiteKey && (
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    />
  )
}

<style>
  .contact-section {
    padding-block: var(--space-8);
    border-bottom: 2px solid var(--vgzt-paper-strong);
    background: var(--vgzt-pink);
  }

  .contact-section__grid {
    display: grid;
    grid-template-columns: minmax(17rem, 0.68fr) minmax(28rem, 1.32fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: start;
  }

  .contact-section__intro {
    position: sticky;
    top: 2rem;
  }

  .contact-section__intro h2 {
    max-width: 9ch;
    margin-bottom: 1.5rem;
  }

  .contact-section__intro p:not(.eyebrow) {
    font-weight: 650;
  }

  .contact-section__intro a {
    font-weight: 900;
  }

  .contact-form {
    display: grid;
    padding: clamp(1.25rem, 3vw, 2.5rem);
    border: var(--keyline);
    background: var(--vgzt-paper-strong);
    gap: 1.1rem;
  }

  .contact-form__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .field {
    display: grid;
    gap: 0.35rem;
  }

  .field label {
    font-size: 0.78rem;
    font-weight: 950;
    letter-spacing: 0.04em;
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 0.8rem;
    border: var(--keyline);
    border-radius: 0;
    background: var(--vgzt-paper);
  }

  .field textarea {
    resize: vertical;
  }

  .field input[aria-invalid='true'],
  .field select[aria-invalid='true'],
  .field textarea[aria-invalid='true'] {
    border-color: var(--vgzt-error);
    box-shadow: inset 0 0 0 1px var(--vgzt-error);
  }

  .field__meta {
    display: flex;
    color: var(--vgzt-muted);
    font-size: 0.7rem;
    justify-content: space-between;
  }

  .field__error {
    min-height: 1em;
    color: var(--vgzt-error);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .field--honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .privacy-check {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.7rem;
    align-items: start;
    font-size: 0.8rem;
    font-weight: 650;
  }

  .privacy-check input {
    width: 1.25rem;
    height: 1.25rem;
    margin: 0.08rem 0 0;
    accent-color: var(--vgzt-ink);
  }

  .contact-form__unavailable {
    margin: 0;
    padding: 0.8rem;
    border-left: 0.4rem solid var(--vgzt-orange);
    background: color-mix(in srgb, var(--vgzt-orange) 24%, var(--vgzt-paper));
    font-size: 0.83rem;
    font-weight: 700;
  }

  .contact-form__submit-row {
    display: flex;
    min-height: 3rem;
    gap: 1rem;
    align-items: center;
  }

  .contact-form__status {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 800;
  }

  @media (max-width: 56rem) {
    .contact-section__grid {
      grid-template-columns: 1fr;
    }

    .contact-section__intro {
      position: static;
    }
  }

  @media (max-width: 36rem) {
    .contact-form__row {
      grid-template-columns: 1fr;
    }

    .contact-form__submit-row {
      display: grid;
    }
  }
</style>

<script>
  declare global {
    interface Window {
      vgztTurnstileComplete?: (token: string) => void;
      vgztTurnstileExpired?: () => void;
      turnstile?: { reset: () => void };
    }
  }

  document
    .querySelectorAll<HTMLFormElement>('[data-contact-form]')
    .forEach((form) => {
      const enabled = form.dataset.enabled === 'true';
      if (!enabled) return;
      const status = form.querySelector<HTMLElement>('[data-form-status]');
      const submit = form.querySelector<HTMLButtonElement>(
        'button[type="submit"]',
      );
      const message = form.elements.namedItem(
        'message',
      ) as HTMLTextAreaElement | null;
      const count = form.querySelector<HTMLElement>('[data-message-count]');
      let turnstileToken = '';

      window.vgztTurnstileComplete = (token) => {
        turnstileToken = token;
      };
      window.vgztTurnstileExpired = () => {
        turnstileToken = '';
      };

      message?.addEventListener('input', () => {
        if (count) count.textContent = String(message.value.length);
      });

      const clearErrors = () => {
        form
          .querySelectorAll('[aria-invalid="true"]')
          .forEach((field) => field.removeAttribute('aria-invalid'));
        form
          .querySelectorAll<HTMLElement>('.field__error')
          .forEach((error) => (error.textContent = ''));
      };

      const setError = (name: string, text: string) => {
        const field = form.elements.namedItem(name) as HTMLElement | null;
        field?.setAttribute('aria-invalid', 'true');
        field?.setAttribute(
          'aria-describedby',
          `contact-${name === 'privacyAccepted' ? 'privacy' : name}-error`,
        );
        const error = form.querySelector<HTMLElement>(
          `#contact-${name === 'privacyAccepted' ? 'privacy' : name}-error`,
        );
        if (error) error.textContent = text;
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        clearErrors();
        if (status) status.textContent = '';

        const data = new FormData(form);
        const name = String(data.get('name') || '').trim();
        const email = String(data.get('email') || '').trim();
        const category = String(data.get('category') || '');
        const body = String(data.get('message') || '').trim();
        const website = String(data.get('website') || '');
        const privacyAccepted = data.get('privacyAccepted') === 'true';
        const verifiedToken =
          turnstileToken ||
          String(data.get('cf-turnstile-response') || '').trim();
        let invalid = false;

        if (!name || name.length > 100) {
          setError('name', 'Enter your name (up to 100 characters).');
          invalid = true;
        }
        if (!/^\S+@\S+\.\S+$/.test(email) || email.length > 254) {
          setError('email', 'Enter a valid email address.');
          invalid = true;
        }
        if (body.length < 10 || body.length > 5000) {
          setError(
            'message',
            'Enter a message between 10 and 5,000 characters.',
          );
          invalid = true;
        }
        if (!privacyAccepted) {
          setError(
            'privacyAccepted',
            'Confirm that VGZT may use these details to reply.',
          );
          invalid = true;
        }
        if (!verifiedToken) {
          if (status)
            status.textContent =
              'Complete the anti-abuse check, then try again.';
          invalid = true;
        }
        if (invalid) {
          form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
          return;
        }

        if (submit) submit.disabled = true;
        if (status) status.textContent = 'Sending…';

        try {
          const response = await fetch(form.dataset.endpoint || '', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name,
              email,
              category,
              message: body,
              website,
              privacyAccepted,
              turnstileToken: verifiedToken,
            }),
          });
          const result = (await response.json().catch(() => ({}))) as {
            message?: string;
          };
          if (!response.ok)
            throw new Error(result.message || 'Message could not be sent.');

          form.reset();
          turnstileToken = '';
          if (count) count.textContent = '0';
          if (status)
            status.textContent = 'Thanks — your message has been sent.';
          window.turnstile?.reset();
        } catch (error) {
          if (status) {
            status.textContent =
              error instanceof Error
                ? error.message
                : 'Message could not be sent. Try again.';
          }
          window.turnstile?.reset();
          turnstileToken = '';
        } finally {
          if (submit) submit.disabled = false;
        }
      });
    });
</script>
