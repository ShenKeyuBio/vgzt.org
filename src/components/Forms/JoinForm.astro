---
interface Props {
  endpoint?: string | null;
  turnstileSiteKey?: string | null;
  email: string;
  slackInviteUrl?: string | null;
  newsletterUrl?: string | null;
  newsletterEmbedScriptUrl?: string | null;
  newsletterFormId?: string | null;
}

const {
  endpoint = null,
  turnstileSiteKey = null,
  email,
  slackInviteUrl = null,
  newsletterUrl = null,
  newsletterEmbedScriptUrl = null,
  newsletterFormId = null,
} = Astro.props;
const fallbackEnabled = Boolean(endpoint && turnstileSiteKey);
const careerStages = [
  { value: 'undergraduate', label: 'Undergraduate student' },
  { value: 'masters', label: "Master's student" },
  { value: 'phd', label: 'PhD student' },
  { value: 'postdoc', label: 'Postdoctoral researcher' },
  { value: 'research-staff', label: 'Research staff' },
  { value: 'faculty-pi', label: 'Faculty / group leader / PI' },
  { value: 'professional', label: 'Professional services / industry' },
  { value: 'other', label: 'Other' },
];
---

<section class="join-section" aria-labelledby="join-form-title">
  <div class="container join-section__grid">
    <div class="join-section__intro">
      <p class="eyebrow">Choose how to stay connected</p>
      <h2 id="join-form-title">Subscribe VGZT Talks.</h2>
      <p>
        Choose Slack, seminar emails, or both. Your details stay in this page
        unless you explicitly ask the organizers for help.
      </p>
      <ul class="join-benefits">
        <li>Seminar announcements and reminders</li>
        <li>Developmental-biology discussion</li>
        <li>Opportunities and community news</li>
      </ul>
      <p class="join-section__note">
        Already connected or need help? Email <a href={`mailto:${email}`}
          >{email}</a
        >.
      </p>
    </div>

    <form
      class="join-form"
      method="post"
      action="/subscribe/"
      data-join-form
      data-endpoint={endpoint || ''}
      data-slack-url={slackInviteUrl || ''}
      data-newsletter-url={newsletterUrl || ''}
      data-newsletter-embed-script-url={newsletterEmbedScriptUrl || ''}
      data-newsletter-form-id={newsletterFormId || ''}
    >
      <fieldset
        class="join-form__choices"
        aria-describedby="join-services-error"
      >
        <legend>What would you like to subscribe to?</legend>
        <label for="join-slack">
          <input
            id="join-slack"
            name="joinSlack"
            type="checkbox"
            value="true"
          />
          <span>Join VGZT Slack</span>
        </label>
        <label for="join-mailing-list">
          <input
            id="join-mailing-list"
            name="joinMailingList"
            type="checkbox"
            value="true"
          />
          <span>Subscribe to VGZT mailing list</span>
        </label>
      </fieldset>
      <span class="field__error" id="join-services-error"></span>

      <div class="join-form__details">
        <div class="join-form__row">
          <div class="field">
            <label for="join-name">Name</label>
            <input
              id="join-name"
              name="name"
              autocomplete="name"
              required
              maxlength="100"
            />
            <span class="field__error" id="join-name-error"></span>
          </div>

          <div class="field">
            <label for="join-organization">Organization</label>
            <input
              id="join-organization"
              name="organization"
              autocomplete="organization"
              required
              maxlength="160"
            />
            <span class="field__error" id="join-organization-error"></span>
          </div>
        </div>

        <div class="field">
          <label for="join-career-stage">Career stage</label>
          <select id="join-career-stage" name="careerStage" required>
            <option value="">Select your career stage</option>
            {
              careerStages.map((stage) => (
                <option value={stage.value}>{stage.label}</option>
              ))
            }
          </select>
          <span class="field__error" id="join-careerStage-error"></span>
        </div>

        <div class="join-form__row">
          <div class="field">
            <label for="join-email">Contact email</label>
            <input
              id="join-email"
              name="email"
              type="email"
              inputmode="email"
              autocomplete="email"
              required
              maxlength="254"
            />
            <span class="field__error" id="join-email-error"></span>
          </div>

          <div class="field">
            <label for="join-slack-email">Email linked to Slack</label>
            <input
              id="join-slack-email"
              name="slackEmail"
              type="email"
              inputmode="email"
              autocomplete="email"
              aria-describedby="join-slack-email-hint join-slackEmail-error"
              maxlength="254"
            />
            <span class="field__hint" id="join-slack-email-hint"
              >Required only when joining Slack; otherwise leave it blank.</span
            >
            <span class="field__error" id="join-slackEmail-error"></span>
          </div>
        </div>
      </div>

      <div class="field field--honeypot" aria-hidden="true">
        <label for="join-website">Website</label>
        <input
          id="join-website"
          name="website"
          tabindex="-1"
          autocomplete="off"
        />
      </div>

      <label class="privacy-check" for="join-privacy">
        <input
          id="join-privacy"
          name="privacyAccepted"
          type="checkbox"
          required
          value="true"
        />
        <span
          >I agree that, if I send a manual request, VGZT may use these details
          to arrange the selected invitation(s). See the <a href="/privacy/"
            >privacy notice</a
          >.</span
        >
      </label>
      <span class="field__error" id="join-privacy-error"></span>

      <div class="join-form__submit-row">
        <button
          class="button button--ink"
          type="submit"
          data-join-submit
          disabled
        >
          Subscribe VGZT Talks <span aria-hidden="true">→</span>
        </button>
        <p
          class="join-form__status"
          role="status"
          aria-live="polite"
          data-form-status
        >
        </p>
        <noscript>
          JavaScript is required to complete this protected subscription flow.
          Email <a href={`mailto:${email}`}>{email}</a> for help.
        </noscript>
      </div>

      <section
        id="subscription-options"
        class="subscription-result"
        aria-labelledby="subscription-result-title"
        aria-live="polite"
        tabindex="-1"
        data-subscription-result
        hidden
      >
        <p class="eyebrow">Your subscription options</p>
        <h3 id="subscription-result-title">
          Continue with your selected service.
        </h3>

        <div class="subscription-result__actions">
          <div data-slack-result hidden>
            <a
              class="button button--ink"
              href={slackInviteUrl || undefined}
              target="_blank"
              rel="noopener noreferrer"
              data-slack-action
              hidden={!slackInviteUrl}
            >
              Join VGZT Slack <span aria-hidden="true">↗</span>
              <span class="visually-hidden"> (opens in a new tab)</span>
            </a>
            <p data-slack-unavailable hidden={Boolean(slackInviteUrl)}>
              The Slack invitation is temporarily unavailable.
            </p>
          </div>

          <div data-newsletter-result hidden>
            <a
              class="button button--ink"
              href={newsletterUrl || undefined}
              target="_blank"
              rel="noopener noreferrer"
              data-newsletter-action
              hidden={!newsletterUrl}
            >
              Subscribe to the mailing list <span aria-hidden="true">↗</span>
              <span class="visually-hidden"> (opens in a new tab)</span>
            </a>
            <p
              class="subscription-result__coming-soon"
              data-newsletter-coming-soon
              hidden={Boolean(newsletterUrl)}
            >
              Mailing list signup coming soon
            </p>
            <div
              class="subscription-result__embed"
              data-newsletter-embed
              tabindex="-1"
              hidden
            >
              <p data-newsletter-loading role="status">
                Loading mailing list signup…
              </p>
              <p data-newsletter-failed role="status" hidden>
                The mailing list form could not load. Please try again or email{
                  ' '
                }
                <a href={`mailto:${email}`}>{email}</a>.
              </p>
              <noscript>
                JavaScript is required for the mailing list form. Email{' '}
                <a href={`mailto:${email}`}>{email}</a> for help.
              </noscript>
            </div>
          </div>
        </div>

        <div class="manual-fallback">
          <p>
            <strong>Not working?</strong> Ask the VGZT organizers to invite you manually.
          </p>
          {
            fallbackEnabled ? (
              <>
                <div
                  class="manual-fallback__turnstile"
                  data-turnstile-container
                  data-sitekey={turnstileSiteKey}
                  hidden
                />
                <button
                  class="button button--quiet"
                  type="button"
                  data-manual-fallback
                >
                  Send a request to the organizers
                </button>
              </>
            ) : (
              <p>
                The secure request form is being connected. Email{' '}
                <a href={`mailto:${email}`}>{email}</a> instead.
              </p>
            )
          }
          <p
            class="join-form__status"
            role="status"
            aria-live="polite"
            tabindex="-1"
            data-fallback-status
          >
          </p>
        </div>
      </section>
    </form>
  </div>
</section>

{
  fallbackEnabled && (
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
      async
      defer
    />
  )
}

<style>
  .join-section {
    padding-block: var(--space-8);
    border-bottom: var(--keyline);
    background: var(--vgzt-cyan);
  }

  .join-section__grid {
    display: grid;
    grid-template-columns: minmax(17rem, 0.68fr) minmax(28rem, 1.32fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: start;
  }

  .join-section__intro {
    position: sticky;
    top: 2rem;
  }

  .join-section__intro h2 {
    max-width: 9ch;
    margin-bottom: 1.5rem;
  }

  .join-section__intro p,
  .join-benefits {
    font-weight: 650;
  }

  .join-benefits {
    margin-block: 1.5rem;
    padding-left: 1.2rem;
  }

  .join-section__note {
    font-size: 0.88rem;
  }

  .join-section__note a {
    font-weight: 900;
  }

  .join-form {
    display: grid;
    padding: clamp(1.25rem, 3vw, 2.5rem);
    border: var(--keyline);
    background: var(--vgzt-paper-strong);
    gap: 1.1rem;
  }

  .join-form__choices {
    display: grid;
    margin: 0;
    padding: 0 0 1rem;
    border: 0;
    border-bottom: var(--keyline);
    gap: 0.7rem;
  }

  .join-form__choices legend {
    margin-bottom: 0.75rem;
    font-size: var(--font-ui-small);
    font-weight: 950;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .join-form__choices label {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.65rem;
    align-items: center;
    font-weight: 850;
  }

  .join-form__choices input,
  .privacy-check input {
    width: 1.25rem;
    height: 1.25rem;
    margin: 0;
    accent-color: var(--vgzt-ink);
  }

  .join-form__choices[aria-invalid='true'] {
    border-color: var(--vgzt-error);
  }

  .join-form__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .join-form__details {
    display: grid;
    padding-block: 1rem;
    border-block: var(--keyline);
    gap: 1rem;
  }

  .field {
    display: grid;
    gap: 0.35rem;
  }

  .field label {
    font-size: var(--font-ui-small);
    font-weight: 950;
    letter-spacing: 0.04em;
  }

  .field input,
  .field select {
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 0.8rem;
    border: var(--keyline);
    border-radius: 0;
    background: var(--vgzt-paper);
  }

  .field input[aria-invalid='true'],
  .field select[aria-invalid='true'] {
    border-color: var(--vgzt-error);
    box-shadow: inset 0 0 0 1px var(--vgzt-error);
  }

  .field__hint {
    color: var(--vgzt-muted);
    font-size: var(--font-ui-small);
  }

  .field__error {
    min-height: 1em;
    color: var(--vgzt-error);
    font-size: var(--font-ui-small);
    font-weight: 800;
  }

  .field--honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .privacy-check {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.7rem;
    align-items: start;
    font-size: var(--font-ui-small);
    font-weight: 650;
  }

  .privacy-check input {
    margin-top: 0.08rem;
  }

  .join-form__submit-row {
    display: flex;
    min-height: 3rem;
    gap: 1rem;
    align-items: center;
  }

  .join-form__status {
    margin: 0;
    font-size: var(--font-ui-small);
    font-weight: 800;
  }

  .subscription-result {
    display: grid;
    margin-top: 0.5rem;
    padding: clamp(1rem, 3vw, 1.6rem);
    border: var(--keyline);
    background: color-mix(in srgb, var(--vgzt-pink) 38%, var(--vgzt-paper));
    gap: 1rem;
  }

  .subscription-result[hidden],
  .subscription-result [hidden] {
    display: none;
  }

  .subscription-result h3,
  .subscription-result p {
    margin: 0;
  }

  .subscription-result__actions {
    display: grid;
    gap: 0.8rem;
  }

  .subscription-result__coming-soon {
    padding: 0.85rem;
    border-left: 0.4rem solid var(--vgzt-orange);
    background: var(--vgzt-paper);
    font-weight: 900;
  }

  .subscription-result__embed {
    min-height: 7rem;
    padding: 0.85rem;
    border: 2px solid var(--vgzt-ink);
    background: var(--vgzt-paper);
  }

  .manual-fallback {
    display: grid;
    padding-top: 1rem;
    border-top: 2px solid var(--vgzt-ink);
    gap: 0.8rem;
  }

  .manual-fallback__turnstile {
    min-height: 4.1rem;
  }

  @media (max-width: 56rem) {
    .join-section__grid {
      grid-template-columns: 1fr;
    }

    .join-section__intro {
      position: static;
    }
  }

  @media (max-width: 36rem) {
    .join-form__row {
      grid-template-columns: 1fr;
    }

    .join-form__submit-row {
      display: grid;
    }
  }
</style>

<script>
  import { resolveSubscriptionFlow } from '../../lib/subscription';

  interface TurnstileApi {
    render: (
      container: HTMLElement,
      options: {
        sitekey: string;
        action: string;
        callback: (token: string) => void;
        'expired-callback': () => void;
        'error-callback': () => void;
      },
    ) => string;
    reset: (widgetId?: string) => void;
  }

  interface PendingSubmission {
    name: string;
    organization: string;
    careerStage: string;
    email: string;
    slackEmail: string | null;
    joinSlack: boolean;
    joinMailingList: boolean;
    website: string;
    privacyAccepted: true;
  }

  document
    .querySelectorAll<HTMLFormElement>('[data-join-form]')
    .forEach((form) => {
      const status = form.querySelector<HTMLElement>('[data-form-status]');
      const primarySubmit =
        form.querySelector<HTMLButtonElement>('[data-join-submit]');
      const resultPanel = form.querySelector<HTMLElement>(
        '[data-subscription-result]',
      );
      const fallbackStatus = form.querySelector<HTMLElement>(
        '[data-fallback-status]',
      );
      const fallbackButton = form.querySelector<HTMLButtonElement>(
        '[data-manual-fallback]',
      );
      const turnstileContainer = form.querySelector<HTMLElement>(
        '[data-turnstile-container]',
      );
      const newsletterEmbed = form.querySelector<HTMLElement>(
        '[data-newsletter-embed]',
      );
      const newsletterLoading = form.querySelector<HTMLElement>(
        '[data-newsletter-loading]',
      );
      const newsletterFailed = form.querySelector<HTMLElement>(
        '[data-newsletter-failed]',
      );
      const links = {
        slackInviteUrl: form.dataset.slackUrl || null,
        newsletterUrl: form.dataset.newsletterUrl || null,
        newsletterEmbedScriptUrl: form.dataset.newsletterEmbedScriptUrl || null,
        newsletterFormId: form.dataset.newsletterFormId || null,
      };
      let pendingSubmission: PendingSubmission | null = null;
      let turnstileToken = '';
      let turnstileWidgetId: string | undefined;
      form.noValidate = true;
      if (primarySubmit) primarySubmit.disabled = false;
      const getTurnstile = (): TurnstileApi | null => {
        const candidate: unknown = Reflect.get(window, 'turnstile');
        return typeof candidate === 'object' &&
          candidate !== null &&
          'render' in candidate &&
          typeof candidate.render === 'function' &&
          'reset' in candidate &&
          typeof candidate.reset === 'function'
          ? (candidate as TurnstileApi)
          : null;
      };

      const clearErrors = () => {
        form
          .querySelectorAll('[aria-invalid="true"]')
          .forEach((field) => field.removeAttribute('aria-invalid'));
        form.querySelectorAll<HTMLElement>('.field__error').forEach((error) => {
          error.textContent = '';
          if (!error.id) return;
          form
            .querySelectorAll<HTMLElement>(`[aria-describedby~="${error.id}"]`)
            .forEach((field) => {
              const tokens = (field.getAttribute('aria-describedby') || '')
                .split(/\s+/)
                .filter((token) => token && token !== error.id);
              if (tokens.length > 0)
                field.setAttribute('aria-describedby', tokens.join(' '));
              else field.removeAttribute('aria-describedby');
            });
        });
      };

      const addDescription = (field: HTMLElement, id: string) => {
        const tokens = new Set(
          (field.getAttribute('aria-describedby') || '')
            .split(/\s+/)
            .filter(Boolean),
        );
        tokens.add(id);
        field.setAttribute('aria-describedby', [...tokens].join(' '));
      };

      const setError = (name: string, text: string) => {
        const field =
          name === 'services'
            ? form.querySelector<HTMLElement>('.join-form__choices')
            : (form.elements.namedItem(name) as HTMLElement | null);
        field?.setAttribute('aria-invalid', 'true');
        const errorId =
          name === 'services'
            ? 'join-services-error'
            : name === 'privacyAccepted'
              ? 'join-privacy-error'
              : `join-${name}-error`;
        if (field) addDescription(field, errorId);
        const error = form.querySelector<HTMLElement>(`#${errorId}`);
        if (error) error.textContent = text;
      };

      const ensureTurnstile = () => {
        const turnstile = getTurnstile();
        if (turnstileWidgetId || !turnstileContainer || !turnstile) {
          return;
        }
        const sitekey = turnstileContainer.dataset.sitekey;
        if (!sitekey) return;
        turnstileWidgetId = turnstile.render(turnstileContainer, {
          sitekey,
          action: 'vgzt_join',
          callback: (token) => {
            turnstileToken = token;
            if (fallbackStatus) fallbackStatus.textContent = '';
          },
          'expired-callback': () => {
            turnstileToken = '';
          },
          'error-callback': () => {
            turnstileToken = '';
          },
        });
      };

      const focusNewsletterEmbed = () => {
        const focusTarget = newsletterEmbed?.querySelector<HTMLElement>(
          'input:not([type="hidden"]), iframe, select, textarea, button, a[href]',
        );
        (focusTarget || newsletterEmbed)?.focus();
      };

      const ensureNewsletterEmbed = () => {
        if (!newsletterEmbed) return;
        if (newsletterEmbed.querySelector('[data-newsletter-embed-script]')) {
          focusNewsletterEmbed();
          return;
        }
        if (!links.newsletterEmbedScriptUrl || !links.newsletterFormId) {
          if (newsletterLoading) newsletterLoading.hidden = true;
          if (newsletterFailed) newsletterFailed.hidden = false;
          return;
        }

        const script = document.createElement('script');
        script.async = true;
        script.src = links.newsletterEmbedScriptUrl;
        script.dataset.form = links.newsletterFormId;
        script.dataset.newsletterEmbedScript = '';
        script.addEventListener('load', () => {
          if (newsletterLoading) newsletterLoading.hidden = true;
          focusNewsletterEmbed();
        });
        script.addEventListener('error', () => {
          if (newsletterLoading) newsletterLoading.hidden = true;
          if (newsletterFailed) newsletterFailed.hidden = false;
          newsletterEmbed.focus();
        });
        newsletterEmbed.append(script);
      };

      const readAndValidate = (): PendingSubmission | null => {
        clearErrors();
        if (status) status.textContent = '';

        const data = new FormData(form);
        const name = String(data.get('name') || '').trim();
        const organization = String(data.get('organization') || '').trim();
        const careerStage = String(data.get('careerStage') || '');
        const email = String(data.get('email') || '').trim();
        const slackEmail = String(data.get('slackEmail') || '').trim();
        const joinSlack = data.get('joinSlack') === 'true';
        const joinMailingList = data.get('joinMailingList') === 'true';
        const website = String(data.get('website') || '');
        const privacyAccepted = data.get('privacyAccepted') === 'true';
        const flow = resolveSubscriptionFlow(
          'primary',
          { joinSlack, joinMailingList },
          links,
        );
        let invalid = false;

        if (!flow.valid) {
          setError('services', flow.message);
          invalid = true;
        }
        if (!name || name.length > 100) {
          setError('name', 'Enter your name (up to 100 characters).');
          invalid = true;
        }
        if (!organization || organization.length > 160) {
          setError(
            'organization',
            'Enter your organization (up to 160 characters).',
          );
          invalid = true;
        }
        if (!careerStage) {
          setError('careerStage', 'Select your career stage.');
          invalid = true;
        }
        if (!/^\S+@\S+\.\S+$/.test(email) || email.length > 254) {
          setError('email', 'Enter a valid contact email address.');
          invalid = true;
        }
        if (
          (joinSlack && !/^\S+@\S+\.\S+$/.test(slackEmail)) ||
          slackEmail.length > 254
        ) {
          setError('slackEmail', 'Enter the email address linked to Slack.');
          invalid = true;
        }
        if (slackEmail && !joinSlack && !/^\S+@\S+\.\S+$/.test(slackEmail)) {
          setError(
            'slackEmail',
            'Enter a valid email address or leave it blank.',
          );
          invalid = true;
        }
        if (!privacyAccepted) {
          setError(
            'privacyAccepted',
            'Confirm how your details may be used for a manual request.',
          );
          invalid = true;
        }

        if (invalid) {
          form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
          return null;
        }

        return {
          name,
          organization,
          careerStage,
          email,
          slackEmail: slackEmail || null,
          joinSlack,
          joinMailingList,
          website,
          privacyAccepted: true,
        };
      };

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        if (primarySubmit?.disabled) return;
        if (primarySubmit) primarySubmit.disabled = true;
        const submission = readAndValidate();
        if (!submission) {
          if (primarySubmit) primarySubmit.disabled = false;
          return;
        }

        const flow = resolveSubscriptionFlow(
          'primary',
          {
            joinSlack: submission.joinSlack,
            joinMailingList: submission.joinMailingList,
          },
          links,
        );
        if (!flow.valid) {
          if (primarySubmit) primarySubmit.disabled = false;
          return;
        }

        const slackResult = form.querySelector<HTMLElement>(
          '[data-slack-result]',
        );
        const slackAction = form.querySelector<HTMLElement>(
          '[data-slack-action]',
        );
        const slackUnavailable = form.querySelector<HTMLElement>(
          '[data-slack-unavailable]',
        );
        const newsletterResult = form.querySelector<HTMLElement>(
          '[data-newsletter-result]',
        );
        const newsletterAction = form.querySelector<HTMLElement>(
          '[data-newsletter-action]',
        );
        const newsletterComingSoon = form.querySelector<HTMLElement>(
          '[data-newsletter-coming-soon]',
        );

        if (slackResult) slackResult.hidden = !submission.joinSlack;
        if (slackAction) slackAction.hidden = flow.slackUrl === null;
        if (slackUnavailable) slackUnavailable.hidden = flow.slackUrl !== null;
        if (newsletterResult)
          newsletterResult.hidden = flow.newsletter === null;
        if (newsletterAction)
          newsletterAction.hidden = flow.newsletter?.state !== 'available';
        if (newsletterComingSoon)
          newsletterComingSoon.hidden =
            flow.newsletter?.state !== 'coming-soon';
        if (newsletterEmbed)
          newsletterEmbed.hidden = flow.newsletter?.state !== 'embedded';

        pendingSubmission = submission;
        if (fallbackStatus) fallbackStatus.textContent = '';
        if (resultPanel) {
          resultPanel.hidden = false;
          resultPanel.focus();
        }
        if (flow.newsletter?.state === 'embedded') {
          ensureNewsletterEmbed();
        }
        if (primarySubmit) primarySubmit.disabled = false;
      });

      form.addEventListener('input', (event) => {
        const target = event.target;
        if (
          !(target instanceof HTMLInputElement) &&
          !(target instanceof HTMLSelectElement)
        ) {
          return;
        }
        if (
          target.name === 'cf-turnstile-response' ||
          target.closest('[data-turnstile-container]')
        ) {
          return;
        }
        if (!pendingSubmission) return;
        pendingSubmission = null;
        turnstileToken = '';
        if (resultPanel) resultPanel.hidden = true;
        if (turnstileContainer) turnstileContainer.hidden = true;
        if (fallbackStatus) fallbackStatus.textContent = '';
        if (fallbackButton) fallbackButton.disabled = false;
        getTurnstile()?.reset(turnstileWidgetId);
      });

      fallbackButton?.addEventListener('click', async () => {
        if (!pendingSubmission) return;
        const flow = resolveSubscriptionFlow(
          'manual-fallback',
          {
            joinSlack: pendingSubmission.joinSlack,
            joinMailingList: pendingSubmission.joinMailingList,
          },
          links,
        );
        if (!flow.valid || !flow.notifyOrganizers) return;

        if (!turnstileToken) {
          if (turnstileContainer) turnstileContainer.hidden = false;
          ensureTurnstile();
          if (fallbackStatus)
            fallbackStatus.textContent =
              'Complete the anti-abuse check, then click the request button again.';
          fallbackStatus?.focus();
          return;
        }

        fallbackButton.disabled = true;
        if (fallbackStatus) fallbackStatus.textContent = 'Sending…';

        try {
          const response = await fetch(form.dataset.endpoint || '', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              ...pendingSubmission,
              turnstileToken,
            }),
          });
          const responseBody = (await response.json().catch(() => ({}))) as {
            message?: string;
          };
          if (!response.ok) {
            throw new Error(
              responseBody.message || 'Request could not be sent.',
            );
          }

          if (fallbackStatus)
            fallbackStatus.textContent =
              'Thanks — your request has been sent to the VGZT organizers.';
          turnstileToken = '';
          getTurnstile()?.reset(turnstileWidgetId);
        } catch (error) {
          if (fallbackStatus) {
            fallbackStatus.textContent =
              error instanceof Error
                ? error.message
                : 'Request could not be sent. Try again.';
          }
          fallbackStatus?.focus();
          turnstileToken = '';
          getTurnstile()?.reset(turnstileWidgetId);
          fallbackButton.disabled = false;
        }
      });
    });
</script>
