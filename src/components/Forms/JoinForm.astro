---
interface Props {
  endpoint?: string | null;
  turnstileSiteKey?: string | null;
  email: string;
}

const { endpoint = null, turnstileSiteKey = null, email } = Astro.props;
const formEnabled = Boolean(endpoint && turnstileSiteKey);
---

<section class="join-section" aria-labelledby="join-form-title">
  <div class="container join-section__grid">
    <div class="join-section__intro">
      <p class="eyebrow">Stay connected</p>
      <h2 id="join-form-title">Stay connected with VGZT.</h2>
      <p>Choose seminar email updates, the VGZT Slack community, or both.</p>
      <ul class="join-benefits">
        <li>Talk announcements and speaker updates</li>
        <li>Developmental-biology discussion</li>
        <li>Opportunities and community news</li>
      </ul>
    </div>

    <form
      class="join-form"
      method="post"
      action="/subscribe/"
      data-join-form
      data-endpoint={endpoint || ''}
    >
      <div class="join-form__fields" data-join-fields>
        <div class="field">
          <label for="join-email">Email</label>
          <input
            id="join-email"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="email"
            placeholder="name@example.com"
            required
            maxlength="254"
          />
          <span class="field__error" id="join-email-error"></span>
        </div>

        <fieldset
          class="join-form__choices"
          aria-describedby="join-services-error"
        >
          <legend>Choose what you'd like</legend>
          <div class="join-form__choice-grid">
            <label for="join-mailing-list">
              <input
                id="join-mailing-list"
                name="joinMailingList"
                type="checkbox"
                value="true"
              />
              <span>
                <strong>Seminar email updates</strong>
                <small>
                  Talk announcements, speaker updates and programme news.
                </small>
              </span>
            </label>
            <label for="join-slack">
              <input
                id="join-slack"
                name="joinSlack"
                type="checkbox"
                value="true"
              />
              <span>
                <strong>VGZT Slack community</strong>
                <small>Discussion, opportunities and community updates.</small>
              </span>
            </label>
          </div>
        </fieldset>
        <span class="field__error" id="join-services-error"></span>

        <div class="field field--honeypot" aria-hidden="true">
          <label for="join-website">Website</label>
          <input
            id="join-website"
            name="website"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <div class="join-form__verification">
          <p id="join-verification-label">Security check</p>
          {
            formEnabled ? (
              <div
                class="join-form__turnstile"
                role="group"
                aria-labelledby="join-verification-label"
                aria-describedby="join-verification-error"
                data-turnstile-container
                data-sitekey={turnstileSiteKey}
              />
            ) : (
              <p>
                The secure subscription form is temporarily unavailable. Email{' '}
                <a href={`mailto:${email}`}>{email}</a> for help.
              </p>
            )
          }
          <span class="field__error" id="join-verification-error"></span>
        </div>

        <div class="join-form__submit-row">
          <button
            class="button button--ink"
            type="submit"
            data-join-submit
            disabled
          >
            Continue <span aria-hidden="true">→</span>
          </button>
          <p
            class="join-form__status"
            role="status"
            aria-live="polite"
            tabindex="-1"
            data-form-status
          >
          </p>
          <noscript>
            JavaScript is required to complete this protected subscription flow.
            Email <a href={`mailto:${email}`}>{email}</a> for help.
          </noscript>
        </div>

        <p class="join-form__privacy">
          By continuing, VGZT will use your email only for the service(s) you
          choose. <a href="/privacy/"
            >Privacy notice <span aria-hidden="true">→</span></a
          >
        </p>
      </div>

      <section
        class="subscription-result"
        aria-labelledby="subscription-result-title"
        aria-live="polite"
        tabindex="-1"
        data-subscription-result
        hidden
      >
        <p class="eyebrow">Stay connected</p>
        <h3 id="subscription-result-title" data-result-title>
          You're almost there.
        </h3>

        <div
          class="subscription-result__service"
          data-mailing-list-result
          hidden
        >
          <p class="subscription-result__label">Email updates</p>
          <p class="subscription-result__message" data-mailing-list-message></p>
          <p class="subscription-result__support" data-mailing-list-support></p>
        </div>

        <div class="subscription-result__service" data-slack-result hidden>
          <p class="subscription-result__label">VGZT Slack</p>
          <p class="subscription-result__message" data-slack-message></p>
          <a
            class="button button--ink"
            target="_blank"
            rel="noopener noreferrer"
            data-slack-action
            hidden
          >
            Join VGZT Slack <span aria-hidden="true">↗</span>
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </div>

        <div class="subscription-result__help">
          <p><strong>Having trouble?</strong></p>
          <p>Contact <a href={`mailto:${email}`}>{email}</a>.</p>
        </div>
      </section>
    </form>
  </div>
</section>

{
  formEnabled && (
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
      async
      defer
    />
  )
}

<style>
  .join-section {
    padding-block: var(--space-8);
    border-bottom: var(--keyline);
    background: var(--vgzt-cyan);
  }

  .join-section__grid {
    display: grid;
    grid-template-columns: minmax(17rem, 0.68fr) minmax(28rem, 1.32fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: start;
  }

  .join-section__intro {
    position: sticky;
    top: 2rem;
  }

  .join-section__intro h2 {
    max-width: 11ch;
    margin-bottom: 1.5rem;
  }

  .join-section__intro p,
  .join-benefits {
    font-weight: 650;
  }

  .join-benefits {
    margin-block: 1.5rem 0;
    padding-left: 1.2rem;
  }

  .join-form {
    min-width: 0;
    padding: clamp(1.25rem, 3vw, 2.5rem);
    border: var(--keyline);
    background: var(--vgzt-paper-strong);
  }

  .join-form__fields,
  .subscription-result {
    display: grid;
    gap: 1.25rem;
  }

  .join-form__fields[hidden],
  .subscription-result[hidden],
  .subscription-result [hidden] {
    display: none;
  }

  .field {
    display: grid;
    gap: 0.4rem;
  }

  .field label,
  .join-form__choices legend,
  .join-form__verification > p:first-child {
    font-size: var(--font-ui-small);
    font-weight: 950;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .field input {
    width: 100%;
    min-height: 3.2rem;
    padding: 0.75rem 0.85rem;
    border: var(--keyline);
    border-radius: 0;
    background: var(--vgzt-paper);
  }

  .field input[aria-invalid='true'],
  .join-form__choices[aria-invalid='true'],
  .join-form__turnstile[aria-invalid='true'] {
    border-color: var(--vgzt-error);
    box-shadow: inset 0 0 0 1px var(--vgzt-error);
  }

  .field__error {
    min-height: 1em;
    color: var(--vgzt-error);
    font-size: var(--font-ui-small);
    font-weight: 800;
  }

  .field--honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .join-form__choices {
    display: grid;
    margin: 0;
    padding: 0;
    border: 0;
    gap: 0.8rem;
  }

  .join-form__choices legend {
    margin-bottom: 0.8rem;
  }

  .join-form__choice-grid {
    display: grid;
    gap: 0.75rem;
  }

  .join-form__choices label {
    display: grid;
    grid-template-columns: auto 1fr;
    min-width: 0;
    padding: 1rem;
    border: 2px solid var(--vgzt-ink);
    background: var(--vgzt-paper);
    gap: 0.8rem;
    align-items: start;
    cursor: pointer;
  }

  .join-form__choices label:has(input:checked) {
    background: color-mix(in srgb, var(--vgzt-pink) 45%, var(--vgzt-paper));
  }

  .join-form__choices input {
    width: 1.25rem;
    height: 1.25rem;
    margin: 0.15rem 0 0;
    accent-color: var(--vgzt-ink);
  }

  .join-form__choices span {
    display: grid;
    gap: 0.2rem;
  }

  .join-form__choices strong {
    font-weight: 950;
  }

  .join-form__choices small {
    color: var(--vgzt-muted);
    font-size: var(--font-ui-small);
    font-weight: 650;
    line-height: 1.45;
  }

  .join-form__verification {
    display: grid;
    min-width: 0;
    padding-top: 1.1rem;
    border-top: var(--keyline);
    gap: 0.65rem;
  }

  .join-form__verification > p {
    margin: 0;
  }

  .join-form__turnstile {
    width: 100%;
    min-width: 0;
    min-height: 4.1rem;
  }

  .join-form__submit-row {
    display: flex;
    min-height: 3rem;
    gap: 1rem;
    align-items: center;
  }

  .join-form__status {
    margin: 0;
    font-size: var(--font-ui-small);
    font-weight: 800;
  }

  .join-form__privacy {
    margin: 0;
    font-size: var(--font-ui-small);
    font-weight: 650;
  }

  .join-form__privacy a,
  .subscription-result__help a {
    font-weight: 900;
  }

  .subscription-result {
    padding: clamp(1rem, 3vw, 1.6rem);
    border: var(--keyline);
    background: color-mix(in srgb, var(--vgzt-pink) 42%, var(--vgzt-paper));
  }

  .subscription-result h3,
  .subscription-result p {
    margin: 0;
  }

  .subscription-result__service {
    display: grid;
    padding: 1rem;
    border: 2px solid var(--vgzt-ink);
    background: var(--vgzt-paper);
    gap: 0.65rem;
  }

  .subscription-result__label {
    font-size: var(--font-ui-small);
    font-weight: 950;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .subscription-result__message {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    font-weight: 900;
  }

  .subscription-result__support {
    color: var(--vgzt-muted);
    font-size: var(--font-ui-small);
    font-weight: 700;
  }

  .subscription-result__service .button {
    justify-self: start;
    margin-top: 0.25rem;
  }

  .subscription-result__help {
    display: grid;
    padding-top: 1rem;
    border-top: 2px solid var(--vgzt-ink);
    gap: 0.2rem;
  }

  @media (max-width: 56rem) {
    .join-section__grid {
      grid-template-columns: 1fr;
    }

    .join-section__intro {
      position: static;
    }
  }

  @media (max-width: 36rem) {
    .join-form__submit-row {
      display: grid;
    }

    .join-form__submit-row .button,
    .subscription-result__service .button {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  interface TurnstileApi {
    render: (
      container: HTMLElement,
      options: {
        sitekey: string;
        action: string;
        size: 'flexible';
        callback: (token: string) => void;
        'expired-callback': () => void;
        'error-callback': () => void;
      },
    ) => string;
    reset: (widgetId?: string) => void;
  }

  type MailingListState =
    'confirmation-required' | 'already-known' | 'temporarily-unavailable';

  type JoinApiResponse =
    | {
        ok: true;
        requestId: string;
        mailingList:
          { requested: false } | { requested: true; state: MailingListState };
        slack:
          | { requested: false }
          | { requested: true; inviteUrl: string }
          | { requested: true; state: 'temporarily-unavailable' };
      }
    | {
        ok: false;
        code?: string;
        message?: string;
        fields?: Record<string, string>;
      };

  document
    .querySelectorAll<HTMLFormElement>('[data-join-form]')
    .forEach((form) => {
      const fieldsPanel = form.querySelector<HTMLElement>('[data-join-fields]');
      const status = form.querySelector<HTMLElement>('[data-form-status]');
      const submit =
        form.querySelector<HTMLButtonElement>('[data-join-submit]');
      const result = form.querySelector<HTMLElement>(
        '[data-subscription-result]',
      );
      const resultTitle = form.querySelector<HTMLElement>(
        '[data-result-title]',
      );
      const mailingListResult = form.querySelector<HTMLElement>(
        '[data-mailing-list-result]',
      );
      const mailingListMessage = form.querySelector<HTMLElement>(
        '[data-mailing-list-message]',
      );
      const mailingListSupport = form.querySelector<HTMLElement>(
        '[data-mailing-list-support]',
      );
      const slackResult = form.querySelector<HTMLElement>(
        '[data-slack-result]',
      );
      const slackMessage = form.querySelector<HTMLElement>(
        '[data-slack-message]',
      );
      const slackAction = form.querySelector<HTMLAnchorElement>(
        '[data-slack-action]',
      );
      const turnstileContainer = form.querySelector<HTMLElement>(
        '[data-turnstile-container]',
      );
      let turnstileToken = '';
      let turnstileWidgetId: string | undefined;
      let turnstileAttempts = 0;

      form.noValidate = true;
      if (submit && form.dataset.endpoint && turnstileContainer) {
        submit.disabled = false;
      }

      const getTurnstile = (): TurnstileApi | null => {
        const candidate: unknown = Reflect.get(window, 'turnstile');
        return typeof candidate === 'object' &&
          candidate !== null &&
          'render' in candidate &&
          typeof candidate.render === 'function' &&
          'reset' in candidate &&
          typeof candidate.reset === 'function'
          ? (candidate as TurnstileApi)
          : null;
      };

      const addDescription = (field: HTMLElement, id: string) => {
        const tokens = new Set(
          (field.getAttribute('aria-describedby') || '')
            .split(/\s+/)
            .filter(Boolean),
        );
        tokens.add(id);
        field.setAttribute('aria-describedby', [...tokens].join(' '));
      };

      const clearErrors = () => {
        form
          .querySelectorAll('[aria-invalid="true"]')
          .forEach((field) => field.removeAttribute('aria-invalid'));
        form.querySelectorAll<HTMLElement>('.field__error').forEach((error) => {
          error.textContent = '';
        });
      };

      const setError = (name: string, message: string) => {
        const normalizedName =
          name === 'joinSlack' || name === 'joinMailingList'
            ? 'services'
            : name;
        const field =
          normalizedName === 'services'
            ? form.querySelector<HTMLElement>('.join-form__choices')
            : normalizedName === 'verification'
              ? turnstileContainer
              : (form.elements.namedItem(normalizedName) as HTMLElement | null);
        const errorId = `join-${normalizedName}-error`;
        field?.setAttribute('aria-invalid', 'true');
        if (field) addDescription(field, errorId);
        const error = form.querySelector<HTMLElement>(`#${errorId}`);
        if (error) error.textContent = message;
      };

      const resetTurnstile = () => {
        turnstileToken = '';
        getTurnstile()?.reset(turnstileWidgetId);
      };

      const ensureTurnstile = (): boolean => {
        if (turnstileWidgetId || !turnstileContainer) return true;
        const turnstile = getTurnstile();
        const sitekey = turnstileContainer.dataset.sitekey;
        if (!turnstile || !sitekey) return false;

        turnstileWidgetId = turnstile.render(turnstileContainer, {
          sitekey,
          action: 'vgzt_join',
          size: 'flexible',
          callback: (token) => {
            turnstileToken = token;
            turnstileContainer.removeAttribute('aria-invalid');
            const error = form.querySelector<HTMLElement>(
              '#join-verification-error',
            );
            if (error) error.textContent = '';
            if (status) status.textContent = '';
          },
          'expired-callback': () => {
            turnstileToken = '';
            setError(
              'verification',
              'Verification expired. Complete the check again.',
            );
          },
          'error-callback': () => {
            turnstileToken = '';
            setError(
              'verification',
              'Verification could not complete. Please try again.',
            );
          },
        });
        return true;
      };

      const initializeTurnstile = () => {
        if (ensureTurnstile()) return;
        turnstileAttempts += 1;
        if (turnstileAttempts < 100) {
          window.setTimeout(initializeTurnstile, 100);
          return;
        }
        setError(
          'verification',
          'Verification could not load. Refresh the page or contact the organizers.',
        );
      };

      const safeSlackUrl = (value: unknown): string | null => {
        if (typeof value !== 'string') return null;
        try {
          const url = new URL(value);
          return url.protocol === 'https:' && url.hostname === 'join.slack.com'
            ? url.href
            : null;
        } catch {
          return null;
        }
      };

      const renderResult = (body: Extract<JoinApiResponse, { ok: true }>) => {
        if (resultTitle) {
          resultTitle.textContent = body.mailingList.requested
            ? "You're almost there."
            : "You're ready.";
        }

        if (mailingListResult) {
          mailingListResult.hidden = !body.mailingList.requested;
        }
        if (body.mailingList.requested && mailingListMessage) {
          if (body.mailingList.state === 'confirmation-required') {
            mailingListMessage.textContent =
              'Check your inbox to confirm your VGZT Talks subscription.';
            if (mailingListSupport) {
              mailingListSupport.textContent =
                "We've sent a confirmation email to the address you provided.";
            }
          } else if (body.mailingList.state === 'already-known') {
            mailingListMessage.textContent =
              'This email is already known to the VGZT mailing list.';
            if (mailingListSupport) {
              mailingListSupport.textContent =
                'If confirmation is still required, please check your inbox.';
            }
          } else {
            mailingListMessage.textContent =
              "We couldn't start the email subscription right now. Please try again.";
            if (mailingListSupport) mailingListSupport.textContent = '';
          }
        }

        if (slackResult) slackResult.hidden = !body.slack.requested;
        if (body.slack.requested) {
          const inviteUrl =
            'inviteUrl' in body.slack
              ? safeSlackUrl(body.slack.inviteUrl)
              : null;
          if (inviteUrl) {
            if (slackMessage) {
              slackMessage.textContent = 'Your Slack invitation is ready.';
            }
            if (slackAction) {
              slackAction.href = inviteUrl;
              slackAction.hidden = false;
            }
          } else {
            if (slackMessage) {
              slackMessage.textContent =
                'Slack access is temporarily unavailable. Please contact the VGZT organizers.';
            }
            if (slackAction) {
              slackAction.removeAttribute('href');
              slackAction.hidden = true;
            }
          }
        }

        if (status) status.textContent = '';
        if (fieldsPanel) fieldsPanel.hidden = true;
        if (result) {
          result.hidden = false;
          result.focus();
        }
        turnstileToken = '';
      };

      const readSelection = () => {
        const data = new FormData(form);
        return {
          email: String(data.get('email') || '').trim(),
          joinMailingList: data.get('joinMailingList') === 'true',
          joinSlack: data.get('joinSlack') === 'true',
          website: String(data.get('website') || ''),
        };
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!submit || submit.disabled) return;

        clearErrors();
        if (status) status.textContent = '';
        const submission = readSelection();
        let invalid = false;

        if (
          !/^\S+@\S+\.\S+$/u.test(submission.email) ||
          submission.email.length > 254
        ) {
          setError('email', 'Enter a valid email address.');
          invalid = true;
        }
        if (!submission.joinMailingList && !submission.joinSlack) {
          setError('services', 'Select email updates, Slack, or both.');
          invalid = true;
        }
        if (!turnstileToken) {
          setError('verification', 'Complete the verification and try again.');
          invalid = true;
        }

        if (invalid) {
          form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
          return;
        }

        const endpoint = form.dataset.endpoint;
        if (!endpoint) {
          if (status) {
            status.textContent =
              'The secure subscription form is temporarily unavailable.';
            status.focus();
          }
          return;
        }

        submit.disabled = true;
        if (status) status.textContent = 'Sending…';

        try {
          const response = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              ...submission,
              turnstileToken,
            }),
          });
          const responseBody = (await response
            .json()
            .catch(() => null)) as JoinApiResponse | null;

          if (!response.ok || responseBody?.ok !== true) {
            if (responseBody?.ok === false && responseBody.fields) {
              Object.entries(responseBody.fields).forEach(([name, message]) => {
                setError(name, message);
              });
            }
            const unavailableMessage =
              responseBody?.ok === false &&
              responseBody.code === 'MAILING_LIST_UNAVAILABLE'
                ? "We couldn't start the email subscription right now. Please try again."
                : responseBody?.ok === false &&
                    responseBody.code === 'SLACK_UNAVAILABLE'
                  ? 'Slack access is temporarily unavailable. Please contact the VGZT organizers.'
                  : responseBody?.ok === false && responseBody.message
                    ? responseBody.message
                    : 'The request could not be completed. Please try again.';
            if (status) {
              status.textContent = unavailableMessage;
              status.focus();
            }
            resetTurnstile();
            return;
          }

          renderResult(responseBody);
        } catch {
          if (status) {
            status.textContent =
              'The request could not be completed. Check your connection and try again.';
            status.focus();
          }
          resetTurnstile();
        } finally {
          if (submit && !fieldsPanel?.hidden) submit.disabled = false;
        }
      });

      form.addEventListener('input', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLInputElement)) return;
        target.removeAttribute('aria-invalid');
        if (target.name === 'email') {
          const error = form.querySelector<HTMLElement>('#join-email-error');
          if (error) error.textContent = '';
        }
        if (target.name === 'joinMailingList' || target.name === 'joinSlack') {
          const choices = form.querySelector<HTMLElement>(
            '.join-form__choices',
          );
          choices?.removeAttribute('aria-invalid');
          const error = form.querySelector<HTMLElement>('#join-services-error');
          if (error) error.textContent = '';
        }
      });

      if (turnstileContainer) initializeTurnstile();
    });
</script>
