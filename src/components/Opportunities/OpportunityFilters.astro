---
const filters = [
  ['all', 'All'],
  ['job', 'Jobs'],
  ['phd', 'PhD'],
  ['postdoc', 'Postdoc'],
  ['funding', 'Funding'],
  ['event', 'Events'],
  ['community', 'Community'],
] as const;
---

<div
  class="opportunity-filters"
  role="group"
  aria-label="Filter opportunities"
  data-opportunity-filters
>
  {
    filters.map(([value, label], index) => (
      <button
        type="button"
        data-filter={value}
        aria-pressed={index === 0 ? 'true' : 'false'}
      >
        {label}
      </button>
    ))
  }
</div>

<style>
  .opportunity-filters {
    display: flex;
    margin-bottom: 2rem;
    overflow-x: auto;
    border: var(--keyline);
    background: var(--vgzt-paper-strong);
    overscroll-behavior-inline: contain;
    scrollbar-color: var(--vgzt-ink) var(--vgzt-paper);
    box-shadow: inset -1.25rem 0 1rem -1rem rgb(11 11 11 / 35%);
  }

  button {
    min-width: max-content;
    min-height: 3rem;
    cursor: pointer;
    padding-inline: 1rem;
    border: 0;
    border-right: var(--keyline);
    border-radius: 0;
    background: var(--vgzt-paper-strong);
    font-size: var(--font-ui-small);
    font-weight: 900;
  }

  button[aria-pressed='true'] {
    background: var(--vgzt-orange);
  }
</style>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-opportunity-filters]')
    .forEach((filters) => {
      const buttons = [
        ...filters.querySelectorAll<HTMLButtonElement>('[data-filter]'),
      ];
      const cards = [
        ...document.querySelectorAll<HTMLElement>('[data-opportunity-type]'),
      ];
      const count = document.querySelector<HTMLElement>(
        '[data-opportunity-count]',
      );
      const noMatch = document.querySelector<HTMLElement>(
        '[data-opportunity-no-match]',
      );

      const applyFilter = (button: HTMLButtonElement, writeUrl = true) => {
        const filter = button.dataset.filter || 'all';
        buttons.forEach((item) =>
          item.setAttribute('aria-pressed', String(item === button)),
        );
        let visible = 0;
        cards.forEach((card) => {
          const show =
            filter === 'all' || card.dataset.opportunityType === filter;
          card.hidden = !show;
          if (show) visible += 1;
        });
        if (count)
          count.textContent = `${visible} active ${visible === 1 ? 'listing' : 'listings'}`;
        if (noMatch) noMatch.hidden = visible !== 0;
        if (writeUrl) {
          const url = new URL(location.href);
          if (filter === 'all') url.searchParams.delete('type');
          else url.searchParams.set('type', filter);
          history.replaceState(null, '', url);
        }
        button.scrollIntoView({ block: 'nearest', inline: 'nearest' });
      };

      buttons.forEach((button) =>
        button.addEventListener('click', () => applyFilter(button)),
      );

      const restoreFromUrl = () => {
        const requested = new URLSearchParams(location.search).get('type');
        const button = requested
          ? buttons.find((item) => item.dataset.filter === requested)
          : buttons[0];
        if (button) applyFilter(button, false);
      };
      window.addEventListener('popstate', restoreFromUrl);
      restoreFromUrl();
    });
</script>
