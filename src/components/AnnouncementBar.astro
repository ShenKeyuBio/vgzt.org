---
interface Props {
  open: boolean;
  seasonLabel: string;
  audience: string;
  formUrl?: string | null;
}

const { open, seasonLabel, audience, formUrl = null } = Astro.props;
---

{
  open && (
    <aside class="announcement" aria-label="Call for abstracts">
      <div class="announcement__inner container">
        <span class="announcement__label">Call for abstracts</span>
        <p class="announcement__copy">
          {seasonLabel} <span aria-hidden="true">·</span> {audience}
        </p>
        {formUrl ? (
          <a
            class="announcement__action"
            href={formUrl}
            rel="noopener noreferrer"
            target="_blank"
          >
            Submit an abstract <span aria-hidden="true">→</span>
          </a>
        ) : (
          <span
            class="announcement__action"
            aria-disabled="true"
            title="Submission link coming soon"
          >
            Submission link coming soon
          </span>
        )}
      </div>
    </aside>
  )
}
