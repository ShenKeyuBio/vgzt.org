---
import type { AbstractCallState } from '../lib/config';

interface Props {
  state: AbstractCallState;
  seasonLabel: string;
  audience: string;
}

const { state, seasonLabel, audience } = Astro.props;
const label =
  state.mode === 'opening-soon'
    ? 'Abstract call · opening soon'
    : 'Call for abstracts · open';
---

{
  state.showBanner && (
    <aside class="announcement" aria-label="Call for abstracts">
      <div class="announcement__inner container">
        <span class="announcement__label">{label}</span>
        <p class="announcement__copy">
          {seasonLabel} <span aria-hidden="true">·</span> {audience}
        </p>
        {state.ctaUrl && state.ctaLabel && (
          <a
            class="announcement__action"
            href={state.ctaUrl}
            rel={state.external ? 'noopener noreferrer' : undefined}
            target={state.external ? '_blank' : undefined}
          >
            {state.ctaLabel} <span aria-hidden="true">→</span>
          </a>
        )}
      </div>
    </aside>
  )
}
