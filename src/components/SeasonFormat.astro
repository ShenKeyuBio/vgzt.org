---
import GlobalSessionTimes from './Schedule/GlobalSessionTimes.astro';

interface Props {
  easternTime?: string | undefined;
  westernTime?: string | undefined;
  alternativeTime?: string | undefined;
}

const {
  easternTime = '10:00',
  westernTime = '12:30',
  alternativeTime = '21:00',
} = Astro.props;
---

<section
  class="format"
  id="global-session-times"
  aria-label="Global session times"
>
  <div class="container format__inner">
    <p class="eyebrow">
      Fridays <span aria-hidden="true">·</span> 3–4 sessions/month
      <span aria-hidden="true">·</span> global time
    </p>
    <ul>
      <li>
        <span>Eastern</span><GlobalSessionTimes time={easternTime} />
      </li>
      <li>
        <span>Western</span><GlobalSessionTimes time={westernTime} />
      </li>
      <li>
        <span>Alternative</span><GlobalSessionTimes time={alternativeTime} />
      </li>
    </ul>
  </div>
</section>

<style>
  .format {
    padding-block: var(--space-6);
    border-bottom: var(--keyline);
    background: var(--vgzt-ink);
    color: var(--vgzt-paper-strong);
  }

  .format__inner {
    display: grid;
    grid-template-columns: minmax(12rem, 0.65fr) minmax(25rem, 1.35fr);
    gap: 2rem;
    align-items: center;
  }

  .format__inner p {
    margin: 0;
  }

  ul {
    display: grid;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgb(255 255 255 / 45%);
    list-style: none;
  }

  li {
    display: grid;
    padding: 0.7rem 0;
    border-bottom: 1px solid rgb(255 255 255 / 45%);
    grid-template-columns: minmax(6.5rem, 0.35fr) minmax(0, 1fr);
    gap: 0.8rem;
    align-items: start;
  }

  li > span {
    font-size: var(--font-ui-small);
    font-weight: 850;
    text-transform: uppercase;
  }

  li :global(.global-session-times) {
    min-width: 0;
  }

  @media (max-width: 58rem) {
    .format__inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 38rem) {
    li {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
