---
import type { EventViewModel } from '../../lib/view-models';
import ScheduleController from './ScheduleController.astro';
import ScheduleStage from './ScheduleStage.astro';

export interface ProgrammeSeasonViewModel {
  id: string;
  label: string;
  start: string;
  end: string;
  status: 'draft' | 'published' | 'archived';
  events: EventViewModel[];
  selectedId: string | null;
}

interface Props {
  seasons: ProgrammeSeasonViewModel[];
  defaultSeasonId: string;
  currentSeasonId: string;
  hasSpeakerPreview?: boolean;
  abstractCtaUrl?: string | null;
  abstractCtaLabel?: string | null;
}

const {
  seasons,
  defaultSeasonId,
  currentSeasonId,
  hasSpeakerPreview = false,
  abstractCtaUrl = null,
  abstractCtaLabel = null,
} = Astro.props;
const archiveSeason = seasons.find(
  ({ status, events }) => status === 'archived' && events.length > 0,
);
---

<div class="programme-switcher" id="programme" data-programme-switcher>
  <div class="container">
    <div
      class="programme-switcher__tabs"
      role="tablist"
      aria-label="VGZT seasons"
    >
      {
        seasons.map((season) => {
          const selected = season.id === defaultSeasonId;
          const state =
            season.id === currentSeasonId && season.events.length === 0
              ? 'Scheduling'
              : season.status === 'archived'
                ? 'Full archive'
                : 'Programme';
          return (
            <button
              id={`programme-tab-${season.id}`}
              type="button"
              role="tab"
              aria-selected={selected}
              aria-controls={`programme-${season.id}`}
              tabindex={selected ? 0 : -1}
              data-programme-season-tab={season.id}
            >
              {season.label} <span aria-hidden="true">·</span> {state}
            </button>
          );
        })
      }
    </div>
  </div>
</div>

{
  seasons.map((season) => (
    <ScheduleStage
      sectionId={`programme-${season.id}`}
      tabId={`programme-tab-${season.id}`}
      seasonLabel={season.label}
      events={season.events}
      selectedId={season.selectedId}
      start={season.start}
      end={season.end}
      archive={season.status === 'archived'}
      active={season.id === defaultSeasonId}
      hasSpeakerPreview={hasSpeakerPreview}
      abstractCtaUrl={abstractCtaUrl}
      abstractCtaLabel={abstractCtaLabel}
      archiveUrl={
        archiveSeason ? `/?season=${archiveSeason.id}#programme` : null
      }
      archiveLabel={archiveSeason?.label ?? null}
    />
  ))
}

<ScheduleController />

<style>
  .programme-switcher {
    padding-top: clamp(2rem, 5vw, 4rem);
    background: var(--vgzt-paper);
  }

  .programme-switcher__tabs {
    display: flex;
    width: fit-content;
    max-width: 100%;
    overflow-x: auto;
    border: var(--keyline);
    background: var(--vgzt-paper-strong);
    overscroll-behavior-inline: contain;
    scrollbar-color: var(--vgzt-ink) var(--vgzt-paper);
    scroll-snap-type: x proximity;
  }

  .programme-switcher__tabs button {
    min-height: 3.2rem;
    cursor: pointer;
    padding: 0.7rem 1rem;
    border: 0;
    border-right: var(--keyline);
    border-radius: 0;
    background: transparent;
    color: var(--vgzt-ink);
    font-weight: 950;
    scroll-snap-align: start;
  }

  .programme-switcher__tabs button:last-child {
    border-right: 0;
  }

  .programme-switcher__tabs button[aria-selected='true'] {
    background: var(--vgzt-orange);
  }
</style>
