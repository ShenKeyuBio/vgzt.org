---
import type { EventViewModel } from '../../lib/view-models';
import EventStage from './EventStage.astro';
import SeasonRail from './SeasonRail.astro';
import TimezoneSelector from './TimezoneSelector.astro';

interface Props {
  sectionId: string;
  tabId: string;
  seasonLabel: string;
  events: EventViewModel[];
  start: string;
  end: string;
  selectedId?: string | null | undefined;
  archive?: boolean;
  active?: boolean;
  hasSpeakerPreview?: boolean;
  abstractCtaUrl?: string | null;
  abstractCtaLabel?: string | null;
  archiveUrl?: string | null;
  archiveLabel?: string | null;
}

const {
  sectionId,
  tabId,
  seasonLabel,
  events,
  start,
  end,
  selectedId = null,
  archive = false,
  active = true,
  hasSpeakerPreview = false,
  abstractCtaUrl = null,
  abstractCtaLabel = null,
  archiveUrl = null,
  archiveLabel = null,
} = Astro.props;
---

<section
  class="section schedule-section"
  id={sectionId}
  role="tabpanel"
  aria-labelledby={tabId}
  data-schedule
  data-persistent-action-obstacle
  data-archive-autoplay={archive && events.length > 1 ? 'true' : 'false'}
  hidden={!active}
>
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{seasonLabel} {archive ? 'archive' : 'programme'}</p>
        <h2 id={`${sectionId}-title`}>
          {
            events.length > 0
              ? 'The poster stage.'
              : `${seasonLabel} programme.`
          }
        </h2>
      </div>
      <p>
        {
          events.length > 0
            ? `Select a seminar to see its poster, speakers, and the correct date and time wherever you are. ${archive ? 'The full archive advances slowly until you interact.' : 'Published sessions appear as organizers confirm them.'}`
            : 'The season rail remains visible while organizers arrange the first published sessions.'
        }
      </p>
    </div>

    {
      events.length > 0 && (
        <TimezoneSelector controlId={`${sectionId}-timezone`} />
      )
    }
    <SeasonRail
      events={events}
      selectedId={selectedId}
      start={start}
      end={end}
      autoplay={archive && events.length > 1}
    />
    {
      events.length > 0 ? (
        <EventStage events={events} selectedId={selectedId} />
      ) : (
        <div class="schedule-empty">
          <div class="schedule-empty__copy">
            <p class="eyebrow">Programme status</p>
            <h3>{seasonLabel} programme scheduling is in progress.</h3>
            <p>
              Published seminar dates and posters will appear here as sessions
              are confirmed.
            </p>
          </div>
          <div class="schedule-empty__actions" aria-label="Programme actions">
            <div class="button-row">
              {hasSpeakerPreview && (
                <a class="button button--ink" href="#speaker-preview">
                  View expected speakers
                </a>
              )}
              {abstractCtaUrl && abstractCtaLabel && (
                <a class="button" href={abstractCtaUrl} data-submit-source>
                  {abstractCtaLabel}
                </a>
              )}
            </div>
            <nav aria-label="More programme options">
              {archiveUrl && archiveLabel && (
                <a href={archiveUrl}>Explore full {archiveLabel} archive →</a>
              )}
              <a href="/subscribe/">Get programme updates →</a>
            </nav>
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .schedule-section {
    background: var(--vgzt-paper);
  }

  .schedule-section :global(.timezone-control) {
    margin-bottom: 1rem;
  }

  .schedule-empty {
    display: grid;
    border: var(--keyline);
    border-top: 0;
    background: var(--vgzt-paper-strong);
    grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr);
  }

  .schedule-empty__copy {
    display: grid;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-right: var(--keyline);
    align-content: center;
    justify-items: start;
  }

  .schedule-empty__copy h3 {
    max-width: 18ch;
    margin-bottom: 1rem;
    font-size: clamp(2rem, 4vw, 3.6rem);
  }

  .schedule-empty__copy p:not(.eyebrow) {
    margin-bottom: 0;
    font-weight: 650;
  }

  .schedule-empty__actions {
    display: grid;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--vgzt-pink);
    gap: 1.25rem;
    align-content: center;
  }

  .schedule-empty__actions .button-row {
    align-items: stretch;
  }

  .schedule-empty__actions .button {
    flex: 1 1 12rem;
  }

  .schedule-empty__actions nav {
    display: grid;
    border-top: var(--keyline);
  }

  .schedule-empty__actions nav a {
    min-height: 2.9rem;
    padding-block: 0.75rem;
    border-bottom: var(--keyline);
    font-weight: 900;
  }

  @media (max-width: 52rem) {
    .schedule-empty {
      grid-template-columns: 1fr;
    }

    .schedule-empty__copy {
      border-right: 0;
      border-bottom: var(--keyline);
    }
  }
</style>
