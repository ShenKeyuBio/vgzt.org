---
import type { EventViewModel } from '../../lib/view-models';
import EventStage from './EventStage.astro';
import SeasonRail from './SeasonRail.astro';
import TimezoneSelector from './TimezoneSelector.astro';

interface Props {
  sectionId: string;
  tabId: string;
  seasonLabel: string;
  events: EventViewModel[];
  start: string;
  end: string;
  selectedId?: string | null | undefined;
  archive?: boolean;
  active?: boolean;
  hasSpeakerPreview?: boolean;
  abstractCtaUrl?: string | null;
  abstractCtaLabel?: string | null;
  archiveUrl?: string | null;
  archiveLabel?: string | null;
}

const {
  sectionId,
  tabId,
  seasonLabel,
  events,
  start,
  end,
  selectedId = null,
  archive = false,
  active = true,
} = Astro.props;
---

<section
  class="section schedule-section"
  id={sectionId}
  role="tabpanel"
  aria-labelledby={tabId}
  data-schedule
  data-persistent-action-obstacle
  data-archive-autoplay={archive && events.length > 1 ? 'true' : 'false'}
  hidden={!active}
>
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{seasonLabel} {archive ? 'archive' : 'programme'}</p>
        <h2 id={`${sectionId}-title`}>
          {
            events.length > 0
              ? 'The poster stage.'
              : `${seasonLabel} programme.`
          }
        </h2>
      </div>
      {
        events.length > 0 && (
          <p>
            {`Select a seminar to see its poster, speakers, and the correct date and time wherever you are. ${archive ? 'The full archive advances slowly until you interact.' : 'Published sessions appear as organizers confirm them.'}`}
          </p>
        )
      }
    </div>

    {
      events.length > 0 && (
        <TimezoneSelector controlId={`${sectionId}-timezone`} />
      )
    }
    <SeasonRail
      events={events}
      selectedId={selectedId}
      start={start}
      end={end}
      autoplay={archive && events.length > 1}
    />
    {
      events.length > 0 ? (
        <EventStage events={events} selectedId={selectedId} />
      ) : (
        <div
          class="programme-years"
          aria-label={`${seasonLabel} programme by calendar year`}
        >
          <section class="programme-year" data-programme-year="2026">
            <div class="programme-year__heading">
              <div>
                <p class="eyebrow">2026 sessions</p>
                <h3>September–December 2026</h3>
              </div>
              <p>Published programme posters</p>
            </div>
            <div class="programme-posters__grid">
              <img
                src="/email-assets/season-08-lineup-september.jpg"
                alt="VGZT Season 8 September 2026 speaker lineup"
                width="1200"
                height="675"
                loading="eager"
                decoding="async"
              />
              <img
                src="/email-assets/season-08-lineup-october.jpg"
                alt="VGZT Season 8 October 2026 speaker lineup"
                width="1200"
                height="675"
                loading="lazy"
                decoding="async"
              />
              <img
                src="/email-assets/season-08-lineup-november-december.jpg"
                alt="VGZT Season 8 November and December 2026 speaker lineup"
                width="1200"
                height="675"
                loading="lazy"
                decoding="async"
              />
            </div>
          </section>

          <section
            class="programme-year programme-year--pending"
            data-programme-year="2027"
          >
            <div class="programme-year__heading">
              <div>
                <p class="eyebrow">2027 sessions</p>
                <h3>January–July 2027</h3>
              </div>
              <p>Schedule in preparation</p>
            </div>
            <p class="programme-year__empty">
              2027 session posters will appear here as dates are confirmed.
            </p>
          </section>
        </div>
      )
    }
  </div>
</section>

<style>
  .schedule-section {
    background: var(--vgzt-paper);
  }

  .schedule-section :global(.timezone-control) {
    margin-bottom: 1rem;
  }

  .programme-years {
    display: grid;
    gap: 1rem;
  }

  .programme-year {
    border: var(--keyline);
    background: var(--vgzt-paper-strong);
  }

  .programme-year__heading {
    display: flex;
    padding: 0.85rem 1rem;
    border-bottom: var(--keyline);
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  .programme-year__heading p,
  .programme-year__heading h3 {
    margin: 0;
  }

  .programme-year__heading h3 {
    margin-top: 0.15rem;
    font-size: clamp(1.35rem, 2.5vw, 2rem);
  }

  .programme-year__heading > p {
    color: var(--vgzt-muted);
    font-size: var(--font-ui-small);
    font-weight: 900;
    text-align: right;
  }

  .programme-year__empty {
    margin: 0;
    padding: clamp(1.25rem, 3vw, 2rem) 1rem;
    color: var(--vgzt-muted);
    font-weight: 800;
  }

  .programme-posters__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .programme-posters__grid img {
    display: block;
    width: 100%;
    height: auto;
  }

  .programme-posters__grid img + img {
    border-left: var(--keyline);
  }

  @media (max-width: 52rem) {
    .programme-year__heading {
      display: block;
    }

    .programme-year__heading > p {
      margin-top: 0.45rem;
      text-align: left;
    }

    .programme-posters__grid {
      grid-template-columns: 1fr;
    }

    .programme-posters__grid img + img {
      border-top: var(--keyline);
      border-left: 0;
    }
  }
</style>
