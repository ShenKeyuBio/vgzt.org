---
import type { EventViewModel } from '../../lib/view-models';
import EventStage from './EventStage.astro';
import SeasonRail from './SeasonRail.astro';
import TimezoneSelector from './TimezoneSelector.astro';

interface Props {
  events: EventViewModel[];
  start: string;
  end: string;
  selectedId?: string | null | undefined;
}

const { events, start, end, selectedId = null } = Astro.props;
---

<section
  class="section schedule-section"
  id="programme"
  aria-labelledby="programme-title"
  data-schedule
>
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Season 8 programme</p>
        <h2 id="programme-title">The poster stage.</h2>
      </div>
      <p>
        Select a seminar to see its poster, speakers, and the correct date and
        time wherever you are. Sessions never auto-rotate.
      </p>
    </div>

    <TimezoneSelector />
    <SeasonRail
      events={events}
      selectedId={selectedId}
      start={start}
      end={end}
    />
    {
      events.length > 0 ? (
        <EventStage events={events} selectedId={selectedId} />
      ) : (
        <div class="schedule-empty">
          <div class="schedule-empty__copy">
            <p class="eyebrow">Programme status</p>
            <h3>Season 8 programme coming soon.</h3>
            <p>
              Published seminar dates and posters will appear here as organizers
              confirm them. No provisional sessions are shown as real events.
            </p>
            <a class="button button--ink" href="/subscribe/">
              Get programme updates
            </a>
          </div>
          <div class="schedule-empty__poster" aria-hidden="true">
            <img src="/assets/poster-placeholder.svg" alt="" />
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .schedule-section {
    background: var(--vgzt-paper);
  }

  .schedule-section :global(.timezone-control) {
    margin-bottom: 1rem;
  }

  .schedule-empty {
    display: grid;
    min-height: 32rem;
    border: var(--keyline);
    border-top: 0;
    background: var(--vgzt-paper-strong);
    grid-template-columns: minmax(18rem, 0.75fr) minmax(20rem, 1.25fr);
  }

  .schedule-empty__copy {
    display: grid;
    padding: clamp(2rem, 5vw, 4.5rem);
    border-right: var(--keyline);
    align-content: center;
    justify-items: start;
  }

  .schedule-empty__copy h3 {
    max-width: 11ch;
    margin-bottom: 1.2rem;
    font-size: clamp(2.4rem, 5vw, 4.8rem);
  }

  .schedule-empty__copy p:not(.eyebrow) {
    margin-bottom: 1.5rem;
    font-weight: 650;
  }

  .schedule-empty__poster {
    display: grid;
    min-height: 32rem;
    padding: clamp(1rem, 4vw, 3rem);
    background: var(--vgzt-ink);
    place-items: center;
  }

  .schedule-empty__poster img {
    width: auto;
    max-height: 38rem;
    object-fit: contain;
  }

  @media (max-width: 52rem) {
    .schedule-empty {
      grid-template-columns: 1fr;
    }

    .schedule-empty__copy {
      border-right: 0;
      border-bottom: var(--keyline);
    }
  }
</style>

<script>
  const storageKey = 'vgzt:timezone';

  function supportedZone(zone: string): boolean {
    try {
      new Intl.DateTimeFormat('en', { timeZone: zone }).format();
      return true;
    } catch {
      return false;
    }
  }

  function detectedZone(): string {
    const zone = Intl.DateTimeFormat().resolvedOptions().timeZone;
    return zone && supportedZone(zone) ? zone : 'UTC';
  }

  function selectedZone(select: HTMLSelectElement): string {
    const stored = localStorage.getItem(storageKey);
    if (stored && stored !== 'auto' && supportedZone(stored)) return stored;
    return select.value !== 'auto' && supportedZone(select.value)
      ? select.value
      : detectedZone();
  }

  function updateTimes(root: HTMLElement, zone: string): void {
    const dateFormatter = new Intl.DateTimeFormat('en-GB', {
      timeZone: zone,
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });
    const dayFormatter = new Intl.DateTimeFormat('en-GB', {
      timeZone: zone,
      day: '2-digit',
    });
    const weekdayFormatter = new Intl.DateTimeFormat('en-GB', {
      timeZone: zone,
      weekday: 'short',
    });
    const timeFormatter = new Intl.DateTimeFormat('en-GB', {
      timeZone: zone,
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
      timeZoneName: 'short',
    });

    root.querySelectorAll<HTMLElement>('[data-local-date]').forEach((node) => {
      const instant = node.dataset.localDate;
      if (instant) node.textContent = dateFormatter.format(new Date(instant));
    });
    root.querySelectorAll<HTMLElement>('[data-local-time]').forEach((node) => {
      const instant =
        node.dataset.localTime ||
        node.closest<HTMLElement>('[data-instant]')?.dataset.instant;
      if (instant) node.textContent = timeFormatter.format(new Date(instant));
    });
    root.querySelectorAll<HTMLElement>('[data-local-day]').forEach((node) => {
      const instant =
        node.closest<HTMLElement>('[data-instant]')?.dataset.instant;
      if (instant) node.textContent = dayFormatter.format(new Date(instant));
    });
    root
      .querySelectorAll<HTMLElement>('[data-local-weekday]')
      .forEach((node) => {
        const instant =
          node.closest<HTMLElement>('[data-instant]')?.dataset.instant;
        if (instant)
          node.textContent = weekdayFormatter.format(new Date(instant));
      });
    root.querySelectorAll<HTMLElement>('[data-local-zone]').forEach((node) => {
      node.textContent = zone.replaceAll('_', ' ');
    });
  }

  document
    .querySelectorAll<HTMLElement>('[data-schedule]')
    .forEach((schedule) => {
      const select = schedule.querySelector<HTMLSelectElement>(
        '[data-timezone-select]',
      );
      const reset = schedule.querySelector<HTMLButtonElement>(
        '[data-timezone-reset]',
      );
      const status = schedule.querySelector<HTMLElement>(
        '[data-timezone-status]',
      );
      if (!select || !reset || !status) return;

      const stored = localStorage.getItem(storageKey);
      if (stored && stored !== 'auto' && supportedZone(stored)) {
        if ([...select.options].some((option) => option.value === stored))
          select.value = stored;
        reset.hidden = false;
      }

      const applyZone = () => {
        const zone = selectedZone(select);
        updateTimes(schedule, zone);
        status.textContent = `Times shown for ${zone.replaceAll('_', ' ')}.`;
      };
      applyZone();

      select.addEventListener('change', () => {
        if (select.value === 'auto') {
          localStorage.removeItem(storageKey);
          reset.hidden = true;
        } else {
          localStorage.setItem(storageKey, select.value);
          reset.hidden = false;
        }
        applyZone();
      });

      reset.addEventListener('click', () => {
        localStorage.removeItem(storageKey);
        select.value = 'auto';
        reset.hidden = true;
        applyZone();
      });

      const tabs = [
        ...schedule.querySelectorAll<HTMLButtonElement>('[data-event-tab]'),
      ];
      const panels = [
        ...schedule.querySelectorAll<HTMLElement>('[data-event-panel]'),
      ];
      if (tabs.length === 0) return;

      const selectTab = (tab: HTMLButtonElement, focus = false) => {
        const id = tab.dataset.eventId;
        tabs.forEach((item) => {
          const active = item === tab;
          item.setAttribute('aria-selected', String(active));
          item.tabIndex = active ? 0 : -1;
        });
        panels.forEach(
          (panel) => (panel.hidden = panel.dataset.eventPanel !== id),
        );
        if (id)
          history.replaceState(
            null,
            '',
            `${location.pathname}?event=${encodeURIComponent(id)}${location.hash}`,
          );
        if (focus) tab.focus();
        tab.scrollIntoView({
          block: 'nearest',
          inline: 'nearest',
          behavior: 'smooth',
        });
      };

      const requested = new URLSearchParams(location.search).get('event');
      const requestedTab = requested
        ? tabs.find((tab) => tab.dataset.eventId === requested)
        : null;
      if (requestedTab) selectTab(requestedTab);

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => selectTab(tab));
        tab.addEventListener('keydown', (event) => {
          let target: number | null = null;
          if (event.key === 'ArrowRight') target = (index + 1) % tabs.length;
          if (event.key === 'ArrowLeft')
            target = (index - 1 + tabs.length) % tabs.length;
          if (event.key === 'Home') target = 0;
          if (event.key === 'End') target = tabs.length - 1;
          if (target !== null) {
            event.preventDefault();
            const next = tabs[target];
            if (next) selectTab(next, true);
          }
        });
      });

      const currentIndex = () =>
        Math.max(
          0,
          tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true'),
        );
      schedule
        .querySelector('[data-event-previous]')
        ?.addEventListener('click', () => {
          const tab = tabs[(currentIndex() - 1 + tabs.length) % tabs.length];
          if (tab) selectTab(tab, true);
        });
      schedule
        .querySelector('[data-event-next]')
        ?.addEventListener('click', () => {
          const tab = tabs[(currentIndex() + 1) % tabs.length];
          if (tab) selectTab(tab, true);
        });
    });
</script>
