---
import { getCollection } from 'astro:content';
import PersonCard from '../components/People/PersonCard.astro';
import SpeakerArchiveCard from '../components/People/SpeakerArchiveCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getFooterSocial,
  getSiteSettings,
  getSocialSettings,
} from '../lib/site-data';

const site = getSiteSettings();
const social = getSocialSettings();
const [peopleEntries, seasonEntries, eventEntries] = await Promise.all([
  getCollection('people', ({ data }) => data.status === 'published'),
  getCollection(
    'seasons',
    ({ data }) => data.status !== 'draft' || data.id === site.currentSeason,
  ),
  getCollection('events', ({ data }) => data.status === 'published'),
]);
const people = peopleEntries.map(({ data }) => ({
  ...data,
  portrait: data.portrait?.src ?? null,
}));
const peopleById = new Map(people.map((person) => [person.id, person]));
const seasons = [...seasonEntries].sort(
  (a, b) => b.data.season - a.data.season,
);
const currentSeason = seasons.find(
  ({ data }) => data.id === site.currentSeason,
);
const currentOrganizers = (currentSeason?.data.organizers || [])
  .map((id) => peopleById.get(id))
  .filter(Boolean);
const publishedSpeakerIds = new Set(
  eventEntries
    .filter(({ data }) => data.id !== 'collection-empty-state')
    .flatMap(({ data }) => data.speakers.map((speaker) => speaker.person)),
);
const speakers = people.filter(
  (person) =>
    person.historicalSeasons.length > 0 || publishedSpeakerIds.has(person.id),
);
const seasonOptionsById = new Map(
  seasons.map(({ data }) => [
    data.id,
    { id: data.id, label: data.label, season: data.season },
  ]),
);
for (const person of speakers) {
  for (const season of person.historicalSeasons) {
    const id = `season-${String(season).padStart(2, '0')}`;
    if (!seasonOptionsById.has(id)) {
      seasonOptionsById.set(id, { id, label: `Season ${season}`, season });
    }
  }
}
const seasonOptions = [...seasonOptionsById.values()].sort(
  (a, b) => b.season - a.season,
);
---

<BaseLayout
  title="People"
  description="VGZT speakers and organizer archive by season."
  email={site.publicEmail}
  social={getFooterSocial(social)}
  masterLogo={site.masterLogo}
>
  <header class="page-hero page-hero--orange">
    <div class="container">
      <p class="eyebrow">Speakers and organizers</p>
      <h1>The people who make VGZT.</h1>
      <p>
        Central person records keep names and current profiles consistent while
        preserving event-specific affiliations in the seminar archive.
      </p>
    </div>
  </header>

  <section
    class="section people-browser"
    aria-labelledby="people-title"
    data-people-browser
  >
    <div class="container">
      <div class="people-browser__controls">
        <div class="people-tabs" role="tablist" aria-label="People views">
          <button
            id="people-tab-speakers"
            type="button"
            role="tab"
            aria-selected="true"
            aria-controls="people-panel-speakers"
            data-people-tab="speakers">Speakers</button
          >
          <button
            id="people-tab-organizers"
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="people-panel-organizers"
            tabindex="-1"
            data-people-tab="organizers">Organizers</button
          >
        </div>
        <label>
          <span>Search people</span>
          <input
            type="search"
            placeholder="Name or affiliation"
            data-people-search
          />
        </label>
        <label>
          <span>Season</span>
          <select data-season-filter>
            <option value="all">All seasons</option>
            {
              seasonOptions.map((season) => (
                <option value={season.id}>{season.label}</option>
              ))
            }
          </select>
        </label>
      </div>
      <p
        class="people-browser__result"
        role="status"
        aria-live="polite"
        data-people-result
      >
      </p>

      <h2 id="people-title" class="visually-hidden">VGZT people archive</h2>
      <section
        id="people-panel-speakers"
        role="tabpanel"
        aria-labelledby="people-tab-speakers"
        data-people-panel="speakers"
      >
        {
          speakers.length > 0 ? (
            <div class="people-grid">
              {speakers.map((person) => (
                <div
                  data-speaker-card
                  data-person-seasons={person.historicalSeasons
                    .map(
                      (season) => `season-${String(season).padStart(2, '0')}`,
                    )
                    .join(' ')}
                  data-person-search={`${person.name} ${person.preferredName || ''} ${person.currentAffiliation || ''}`}
                >
                  <SpeakerArchiveCard
                    id={person.id}
                    name={person.name}
                    preferredName={person.preferredName}
                    affiliation={person.currentAffiliation}
                  />
                </div>
              ))}
            </div>
          ) : (
            <div class="empty-state">
              <p class="eyebrow">Speaker archive</p>
              <h3>Published speakers will appear with the programme.</h3>
              <p>
                No unconfirmed or example speakers are presented as real VGZT
                participants.
              </p>
            </div>
          )
        }
      </section>

      <section
        id="people-panel-organizers"
        role="tabpanel"
        aria-labelledby="people-tab-organizers"
        data-people-panel="organizers"
        hidden
      >
        <div class="season-groups">
          {
            seasons.map(({ data: season }) => {
              const organizers = season.organizers
                .map((id) => peopleById.get(id))
                .filter(Boolean);
              if (organizers.length === 0) return null;
              return (
                <section class="season-group" data-season-group={season.id}>
                  <div class="season-group__heading">
                    <p class="eyebrow">
                      {season.id === site.currentSeason
                        ? 'Current season'
                        : 'Archive'}
                    </p>
                    <h3>{season.label}</h3>
                  </div>
                  <div class="people-grid">
                    {organizers.map(
                      (person) =>
                        person && (
                          <div
                            data-organizer-card
                            data-person-search={`${person.name} ${person.preferredName || ''} ${person.currentAffiliation || ''}`}
                          >
                            <PersonCard
                              id={person.id}
                              name={person.name}
                              preferredName={person.preferredName}
                              affiliation={person.currentAffiliation}
                              country={person.country}
                              portrait={person.portrait}
                              portraitAlt={person.portraitAlt}
                              website={person.website}
                              profileIncomplete={person.status === 'draft'}
                            />
                          </div>
                        ),
                    )}
                  </div>
                </section>
              );
            })
          }
        </div>
      </section>
      {
        currentOrganizers.length === 0 && (
          <p>No organizer records are available.</p>
        )
      }
      <div
        class="people-browser__no-match empty-state"
        data-people-no-match
        hidden
      >
        <h3>No matching people.</h3>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .people-browser__controls {
    display: grid;
    margin-bottom: 2rem;
    padding: 0.7rem;
    border: var(--keyline);
    background: var(--vgzt-paper-strong);
    grid-template-columns: auto 1fr minmax(10rem, 0.45fr);
    gap: 0.7rem;
    align-items: end;
  }

  .people-tabs {
    display: flex;
  }

  .people-tabs button,
  .people-browser__controls input,
  .people-browser__controls select {
    min-height: 3rem;
    border: var(--keyline);
    border-radius: 0;
    background: var(--vgzt-paper);
    font-weight: 800;
  }

  .people-tabs button {
    cursor: pointer;
    padding-inline: 1rem;
  }

  .people-tabs button + button {
    border-left: 0;
  }

  .people-tabs button[aria-selected='true'] {
    background: var(--vgzt-orange);
  }

  .people-browser__controls label {
    display: grid;
    gap: 0.3rem;
    font-size: var(--font-ui-small);
    font-weight: 950;
  }

  .people-browser__controls input,
  .people-browser__controls select {
    width: 100%;
    padding-inline: 0.75rem;
  }

  .people-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .people-grid > :global(div) {
    content-visibility: auto;
    contain-intrinsic-block-size: 22rem;
  }

  .people-browser__result {
    min-height: 1.4rem;
    margin: -1rem 0 1.5rem;
    font-size: var(--font-ui-small);
    font-weight: 850;
  }

  .people-browser__no-match {
    min-height: 0;
    margin-top: 1.5rem;
  }

  .season-group + .season-group {
    margin-top: 4rem;
  }

  .season-group__heading {
    margin-bottom: 1.5rem;
  }

  .season-group__heading h3 {
    font-size: clamp(2rem, 4vw, 3.6rem);
  }

  @media (max-width: 64rem) {
    .people-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 50rem) {
    .people-browser__controls {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 42rem) {
    .people-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-people-browser]')
    .forEach((browser) => {
      const tabs = [
        ...browser.querySelectorAll<HTMLButtonElement>('[data-people-tab]'),
      ];
      const panels = [
        ...browser.querySelectorAll<HTMLElement>('[data-people-panel]'),
      ];
      const search = browser.querySelector<HTMLInputElement>(
        '[data-people-search]',
      );
      const season = browser.querySelector<HTMLSelectElement>(
        '[data-season-filter]',
      );
      const speakerCards = [
        ...browser.querySelectorAll<HTMLElement>('[data-speaker-card]'),
      ];
      const organizerCards = [
        ...browser.querySelectorAll<HTMLElement>('[data-organizer-card]'),
      ];
      const organizerGroups = [
        ...browser.querySelectorAll<HTMLElement>('[data-season-group]'),
      ];
      const result = browser.querySelector<HTMLElement>('[data-people-result]');
      const noMatch = browser.querySelector<HTMLElement>(
        '[data-people-no-match]',
      );

      const normalizeSearch = (value: string) =>
        value
          .normalize('NFD')
          .replace(/\p{Diacritic}/gu, '')
          .toLowerCase()
          .trim();

      const activeView = () =>
        tabs.find((tab) => tab.getAttribute('aria-selected') === 'true')
          ?.dataset.peopleTab || 'speakers';

      const updateUrl = () => {
        const url = new URL(location.href);
        const view = activeView();
        const seasonValue = season?.value || 'all';
        const query = search?.value.trim() || '';
        if (view === 'speakers') url.searchParams.delete('view');
        else url.searchParams.set('view', view);
        if (seasonValue === 'all') url.searchParams.delete('season');
        else url.searchParams.set('season', seasonValue);
        if (query) url.searchParams.set('q', query);
        else url.searchParams.delete('q');
        history.replaceState(null, '', url);
      };

      const applyFilters = (writeUrl = true) => {
        const term = normalizeSearch(search?.value || '');
        const selectedSeason = season?.value || 'all';
        const view = activeView();

        speakerCards.forEach((card) => {
          const searchMismatch =
            term.length > 0 &&
            !normalizeSearch(card.dataset.personSearch || '').includes(term);
          const seasonMismatch =
            selectedSeason !== 'all' &&
            !card.dataset.personSeasons?.split(' ').includes(selectedSeason);
          card.hidden = searchMismatch || seasonMismatch;
        });

        organizerCards.forEach((card) => {
          const searchMismatch =
            term.length > 0 &&
            !normalizeSearch(card.dataset.personSearch || '').includes(term);
          const group = card.closest<HTMLElement>('[data-season-group]');
          const seasonMismatch =
            selectedSeason !== 'all' &&
            group?.dataset.seasonGroup !== selectedSeason;
          card.hidden = searchMismatch || seasonMismatch;
        });

        organizerGroups.forEach((group) => {
          const seasonMismatch =
            selectedSeason !== 'all' &&
            group.dataset.seasonGroup !== selectedSeason;
          const hasVisibleCard = [
            ...group.querySelectorAll('[data-organizer-card]'),
          ].some((card) => !(card as HTMLElement).hidden);
          group.hidden = seasonMismatch || !hasVisibleCard;
        });

        const activeCards = view === 'speakers' ? speakerCards : organizerCards;
        const visible = activeCards.filter((card) => !card.hidden).length;
        if (result) {
          result.textContent = `${visible} ${view === 'speakers' ? 'speakers' : 'organizers'} shown`;
        }
        if (noMatch) noMatch.hidden = visible !== 0;
        if (writeUrl) updateUrl();
      };

      const selectTab = (
        button: HTMLButtonElement,
        focus = false,
        writeUrl = true,
      ) => {
        const view = button.dataset.peopleTab;
        tabs.forEach((tab) => {
          const selected = tab === button;
          tab.setAttribute('aria-selected', String(selected));
          tab.tabIndex = selected ? 0 : -1;
        });
        panels.forEach(
          (panel) => (panel.hidden = panel.dataset.peoplePanel !== view),
        );
        if (focus) button.focus();
        applyFilters(writeUrl);
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => selectTab(tab));
        tab.addEventListener('keydown', (event) => {
          let target: number | null = null;
          if (event.key === 'ArrowRight') target = (index + 1) % tabs.length;
          if (event.key === 'ArrowLeft')
            target = (index - 1 + tabs.length) % tabs.length;
          if (event.key === 'Home') target = 0;
          if (event.key === 'End') target = tabs.length - 1;
          if (target === null) return;
          event.preventDefault();
          const next = tabs[target];
          if (next) selectTab(next, true);
        });
      });

      let inputFrame: number | undefined;
      search?.addEventListener('input', () => {
        if (inputFrame !== undefined) cancelAnimationFrame(inputFrame);
        inputFrame = requestAnimationFrame(() => applyFilters());
      });
      season?.addEventListener('change', () => applyFilters());

      const restoreFromUrl = () => {
        const params = new URLSearchParams(location.search);
        const view = params.get('view');
        const requestedTab = tabs.find((tab) => tab.dataset.peopleTab === view);
        const requestedSeason = params.get('season');
        if (
          season &&
          requestedSeason &&
          [...season.options].some((option) => option.value === requestedSeason)
        ) {
          season.value = requestedSeason;
        } else if (season) {
          season.value = 'all';
        }
        if (search) search.value = params.get('q') || '';
        selectTab(requestedTab || tabs[0]!, false, false);
      };

      window.addEventListener('popstate', restoreFromUrl);
      restoreFromUrl();
    });
</script>
