---
import { getEntry } from 'astro:content';
import EarlyCareerTalkAwards from '../components/Awards/EarlyCareerTalkAwards.astro';
import MicrosoftFormEmbed from '../components/Forms/MicrosoftFormEmbed.astro';
import GlobalSessionTimes from '../components/Schedule/GlobalSessionTimes.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAbstractCallState, safeHttpsUrl } from '../lib/config';
import {
  getAbstractCallSettings,
  getFooterSocial,
  getSessionSettings,
  getSiteSettings,
  getSocialSettings,
} from '../lib/site-data';
import { formatEventTime } from '../lib/time';

const site = getSiteSettings();
const social = getSocialSettings();
const call = getAbstractCallSettings();
const state = getAbstractCallState(call);
const sessions = getSessionSettings();
const seasonEntry = await getEntry('seasons', call.season);
const seasonLabel = seasonEntry?.data.label || call.season;
const earlyCareerTalkAward = seasonEntry?.data.awards?.earlyCareerTalk;
const awardSummaryLabel = earlyCareerTalkAward?.title.replace(/\.\*$/, '*');
const speakerPreview = seasonEntry?.data.speakerPreview;
const timeSlots = sessions.timeSlots.filter((slot) =>
  call.preferredTimeSlots.includes(slot.id),
);
const formUrl = safeHttpsUrl(call.formUrl);
const twoSpeaker = sessions.sessionTypes.find(({ id }) => id === 'two-speaker');
const twoSpeakerTiming = twoSpeaker
  ? {
      slot:
        twoSpeaker.presentationMinutesPerSpeaker +
        twoSpeaker.qaMinutesPerSpeaker,
      presentation: twoSpeaker.presentationMinutesPerSpeaker,
      qa: twoSpeaker.qaMinutesPerSpeaker,
    }
  : null;
const twoSpeakerSlotLabel = twoSpeakerTiming
  ? `${twoSpeakerTiming.slot}-minute`
  : null;
const deadline = call.deadline
  ? formatEventTime(
      {
        date: call.deadline.date,
        time: call.deadline.time,
        timezone: call.deadline.timezone,
      },
      call.deadline.timezone,
    ).reference
  : null;
const deadlineLabel = deadline
  ? `${deadline.dateLabel}, ${deadline.timeLabel}`
  : state.mode === 'open'
    ? 'Rolling · until available slots are filled'
    : 'To be confirmed';
const supportingLine =
  'Submit a short abstract to present alongside a VGZT speaker.';
const configuredDescription =
  call.description?.trim() ||
  'Season 8 abstract-call details will be published here as soon as they are confirmed.';
const descriptionBody = configuredDescription.startsWith(supportingLine)
  ? configuredDescription.slice(supportingLine.length).trim()
  : configuredDescription;
const abstractWordLimit = '150–300 words';
const toParagraphs = (copy: string | null | undefined, fallback: string) =>
  (copy?.trim() || fallback)
    .split(/\n\s*\n/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean);
const eligibilityParagraphs = toParagraphs(
  call.eligibility,
  'Confirmed eligibility guidance will be added before submissions open.',
);
const reviewParagraphs = toParagraphs(
  call.reviewDescription,
  'The organizing team will publish how submissions are matched before submissions open.',
);
---

<BaseLayout
  title="Call for abstracts"
  description="VGZT Season 8 rolling call for early-career researchers to present peri-gastrulation research alongside Season 8 speakers."
  email={site.publicEmail}
  social={getFooterSocial(social)}
  masterLogo={site.masterLogo}
>
  <header class="page-hero page-hero--orange">
    <div class="container">
      <p class="eyebrow">
        {seasonLabel}
        <span aria-hidden="true">·</span>
        {call.audience}
      </p>
      <h1>Share your science with VGZT.</h1>
      <p class="abstract-hero__supporting">
        {supportingLine}
      </p>
      {
        descriptionBody && (
          <p class="abstract-hero__description">{descriptionBody}</p>
        )
      }
      <div class="button-row">
        {
          state.canSubmit && state.ctaUrl ? (
            <a
              class="button button--ink"
              href={state.ctaUrl}
              rel={state.external ? 'noopener noreferrer' : undefined}
              target={state.external ? '_blank' : undefined}
            >
              Submit your abstract
            </a>
          ) : state.mode === 'opening-soon' ? (
            <span class="status-badge">Submissions opening soon</span>
          ) : state.mode === 'open' ? (
            <span class="status-badge">Submission form being finalized</span>
          ) : (
            <span class="status-badge">Call currently closed</span>
          )
        }
      </div>
      {
        earlyCareerTalkAward?.enabled ? (
          <a class="abstract-hero__award-link" href="#early-career-awards">
            Season 8 includes two Early Career Talk Awards
            <span aria-hidden="true">→</span>
          </a>
        ) : null
      }
    </div>
  </header>

  <section
    class="section section--compact abstract-glance"
    aria-labelledby="abstract-glance-title"
  >
    <div class="container">
      <div class="abstract-glance__heading">
        <div>
          <p class="eyebrow">Abstract call</p>
          <h2 id="abstract-glance-title">At a glance.</h2>
        </div>
        {
          state.canSubmit && formUrl ? (
            <a class="button button--ink" href="#submit">
              Submit your abstract →
            </a>
          ) : null
        }
      </div>
      <dl class="abstract-glance__grid">
        <div><dt>Audience</dt><dd>{call.audience}</dd></div>
        <div><dt>Abstract</dt><dd>{abstractWordLimit}</dd></div>
        <div><dt>Selection</dt><dd>Not competitively ranked</dd></div>
        <div><dt>Deadline</dt><dd>{deadlineLabel}</dd></div>
        {
          earlyCareerTalkAward?.enabled ? (
            <div>
              <dt>Recognition</dt>
              <dd>{awardSummaryLabel}</dd>
            </div>
          ) : null
        }
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container abstracts-grid">
      <aside class="abstracts-rail" aria-label="Abstract call navigation">
        <div>
          <h2 class="abstracts-rail__heading">Call status</h2>
          <dl class="call-status">
            <div>
              <dt>Status</dt>
              <dd>
                {
                  state.mode === 'opening-soon'
                    ? 'Opening soon'
                    : state.mode === 'open'
                      ? 'Open'
                      : 'Closed'
                }
              </dd>
            </div>
            <div><dt>Season</dt><dd>{seasonLabel}</dd></div>
            <div><dt>Audience</dt><dd>{call.audience}</dd></div>
            <div>
              <dt>Deadline</dt>
              <dd>{deadlineLabel}</dd>
            </div>
          </dl>
        </div>

        <nav
          class="abstracts-toc"
          aria-labelledby="abstracts-toc-title"
          data-section-nav
        >
          <h2 id="abstracts-toc-title" class="abstracts-rail__heading">
            On this page
          </h2>
          <ol>
            <li>
              <a href="#eligibility" aria-current="location">Who can apply</a>
            </li>
            <li><a href="#submission-requirements">What to submit</a></li>
            <li><a href="#seminar-format">Seminar format</a></li>
            {
              earlyCareerTalkAward?.enabled ? (
                <li>
                  <a href="#early-career-awards">Early Career Talk Awards</a>
                </li>
              ) : null
            }
            <li><a href="#matching">How submissions are matched</a></li>
            <li><a href="#session-times">Preferred session times</a></li>
            <li><a href="#faq">FAQ</a></li>
            {
              state.canSubmit && formUrl ? (
                <li>
                  <a href="#submit">Submit abstract</a>
                </li>
              ) : null
            }
          </ol>
        </nav>

        {
          state.canSubmit && formUrl ? (
            <a class="button button--ink abstracts-rail__submit" href="#submit">
              Submit abstract
            </a>
          ) : null
        }
      </aside>

      <div class="prose abstracts-copy">
        <section id="eligibility" class="abstracts-copy__section">
          <h2>Who can apply</h2>
          <div class="abstracts-copy__stack">
            {eligibilityParagraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </section>

        <section id="submission-requirements" class="abstracts-copy__section">
          <h2>What to submit</h2>
          {
            call.whatToSubmit.length > 0 ? (
              <ul>
                {call.whatToSubmit.map((item) => {
                  const parts = item.split(abstractWordLimit);
                  return (
                    <li>
                      {parts.length > 1 ? (
                        <>
                          {parts[0]}
                          <strong>{abstractWordLimit}</strong>
                          {parts.slice(1).join(abstractWordLimit)}
                        </>
                      ) : (
                        item
                      )}
                    </li>
                  );
                })}
              </ul>
            ) : (
              <p>
                Submission requirements are being finalized and will appear here
                before the form opens.
              </p>
            )
          }
        </section>

        <section id="seminar-format" class="abstracts-copy__section">
          <h2>Seminar format</h2>
          <p>
            Early-career speakers normally share a two-speaker session with a
            related VGZT speaker. Pairings are based on scientific theme.
          </p>
          {
            twoSpeakerTiming ? (
              <dl class="seminar-format">
                <div>
                  <dt>Slot</dt>
                  <dd>{twoSpeakerSlotLabel}</dd>
                </div>
                <div>
                  <dt>Presentation</dt>
                  <dd>{twoSpeakerTiming.presentation} minutes</dd>
                </div>
                <div>
                  <dt>Questions</dt>
                  <dd>{twoSpeakerTiming.qa} minutes</dd>
                </div>
              </dl>
            ) : null
          }
        </section>

        <section id="matching" class="abstracts-copy__section">
          <h2>How submissions are matched</h2>
          <div class="abstracts-copy__stack">
            {reviewParagraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          {
            speakerPreview?.enabled && speakerPreview.speakers.length > 0 ? (
              <p class="abstracts-copy__preview-link">
                You can also browse the current{' '}
                <a href="/#speaker-preview">Season 8 Speaker Preview</a>. Dates
                are still being arranged and availability may change.
              </p>
            ) : null
          }
        </section>

        <section id="session-times" class="abstracts-copy__section">
          <h2 id="preferred-session-times">Preferred session times</h2>
          <p>
            Sessions use America/New_York. The world times below are calculated
            for the next Friday session and update automatically for seasonal
            clock changes. Exact dates are arranged after a thematic match, so
            no date commitment is needed when applying.
          </p>
          <ul class="preferred-session-times">
            {
              timeSlots.map((slot) => (
                <li>
                  <span>{slot.label}</span>
                  <GlobalSessionTimes time={slot.time} />
                </li>
              ))
            }
          </ul>
        </section>

        <section id="faq" class="abstracts-copy__section">
          <h2>FAQ</h2>
          <div class="faq-list">
            {
              call.faq.map((item) => (
                <details>
                  <summary>{item.question}</summary>
                  <p>{item.answer}</p>
                </details>
              ))
            }
          </div>
        </section>
      </div>
    </div>
  </section>

  {
    earlyCareerTalkAward ? (
      <EarlyCareerTalkAwards award={earlyCareerTalkAward} />
    ) : null
  }

  {
    state.canSubmit && formUrl ? (
      <section
        id="submit"
        class="section section--pink abstracts-submit"
        aria-labelledby="submit-title"
      >
        <div class="container">
          <div class="section-heading">
            <h2 id="submit-title">Submit your abstract</h2>
            <p>
              The Microsoft Form is embedded below so you can stay in the VGZT
              page context while submitting.
            </p>
          </div>
          <MicrosoftFormEmbed
            formUrl={formUrl}
            title="VGZT Season 8 abstract submission form"
          />
        </div>
      </section>
    ) : null
  }

  <section class="section section--orange section--compact abstracts-followup">
    <div class="container abstracts-followup__inner">
      <div>
        <p class="eyebrow">Stay updated</p>
        <h2>Stay updated.</h2>
        <p>
          Subscribe to the official VGZT seminar mailing list, join the VGZT
          Slack community, or both, for programme and Abstract Call updates.
        </p>
      </div>
      <a class="button button--ink" href="/subscribe/">Stay updated</a>
    </div>
  </section>

  <section class="section section--ink abstracts-contact">
    <div class="container">
      <h2>Questions?</h2>
      <p>
        If you are unsure whether your project fits the VGZT scope or have a
        question about the call, contact the Season 8 organizing team at
        <a href={`mailto:${site.publicEmail}`}>{site.publicEmail}</a>.
      </p>
      <p><a href="/people/">Meet the Season 8 organizing team →</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .abstract-glance {
    background: var(--vgzt-paper);
  }

  .abstract-glance__heading {
    display: flex;
    margin-bottom: 1.5rem;
    gap: 1.5rem;
    align-items: end;
    justify-content: space-between;
  }

  .abstract-glance__heading h2 {
    margin-bottom: 0;
    font-size: clamp(2.2rem, 4vw, 4rem);
  }

  .abstract-glance__grid {
    display: grid;
    margin: 0;
    grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr));
    gap: 0.65rem;
  }

  .abstract-glance__grid div {
    min-width: 0;
    padding: 0.9rem;
    border: var(--keyline);
    background: var(--vgzt-paper-strong);
  }

  .abstract-glance__grid dd {
    overflow-wrap: anywhere;
  }

  .abstract-hero__supporting {
    max-width: 42rem;
    margin-bottom: 0.9rem;
    font-size: clamp(1.4rem, 3vw, 2rem) !important;
    font-weight: 900 !important;
    line-height: 1.12;
  }

  .abstract-hero__description {
    max-width: 50rem;
    margin-bottom: 0;
    font-size: clamp(1.05rem, 1.8vw, 1.25rem) !important;
    font-weight: 700 !important;
    line-height: 1.45;
  }

  .page-hero .button-row {
    margin-top: 1.7rem;
  }

  .abstract-hero__award-link {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    margin-top: 1rem;
    font-size: 0.95rem;
    font-weight: 900;
  }

  .abstracts-grid {
    display: grid;
    grid-template-columns: minmax(16rem, 0.55fr) minmax(25rem, 1.45fr);
    gap: clamp(2.5rem, 8vw, 8rem);
    align-items: start;
  }

  .abstracts-rail {
    position: sticky;
    top: 6.35rem;
    display: grid;
    max-height: calc(100vh - 7.35rem);
    padding: 0.4rem;
    overflow-y: auto;
    gap: 1.5rem;
    align-self: start;
    scrollbar-color: var(--vgzt-ink) var(--vgzt-paper);
  }

  .abstracts-rail__heading {
    margin: 0 0 0.7rem;
    font-size: 0.75rem;
    font-weight: 950;
    letter-spacing: 0.14em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .call-status {
    margin: 0;
    border-top: var(--keyline);
  }

  .call-status div {
    padding-block: 0.8rem;
    border-bottom: var(--keyline);
  }

  .abstracts-toc {
    min-width: 0;
  }

  .abstracts-toc ol {
    margin: 0;
    padding: 0;
    border-top: var(--keyline);
    list-style: none;
  }

  .abstracts-toc li {
    border-bottom: var(--keyline);
  }

  .abstracts-toc a {
    display: flex;
    min-height: 2.75rem;
    padding: 0.55rem 0.6rem;
    border-left: 0.4rem solid transparent;
    align-items: center;
    font-size: 0.86rem;
    font-weight: 800;
    line-height: 1.2;
    text-decoration: none;
  }

  .abstracts-toc a:hover {
    text-decoration: underline;
  }

  .abstracts-toc a[aria-current='location'] {
    border-left-color: var(--vgzt-ink);
    background: var(--vgzt-orange);
    font-weight: 950;
  }

  .abstracts-rail__submit {
    width: 100%;
  }

  dt {
    font-size: 0.68rem;
    font-weight: 950;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  dd {
    margin: 0.2rem 0 0;
    font-weight: 800;
  }

  .abstracts-copy__section:first-child h2 {
    margin-top: 0;
  }

  .abstracts-copy__stack p + p {
    margin-top: 1rem;
  }

  .abstracts-copy li + li {
    margin-top: 0.6rem;
  }

  .abstracts-copy strong {
    font-weight: 950;
  }

  .seminar-format {
    display: grid;
    margin: 1.25rem 0 1.8rem;
    border: var(--keyline);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .seminar-format div {
    padding: 0.8rem;
  }

  .seminar-format div + div {
    border-left: var(--keyline);
  }

  .seminar-format dd {
    font-size: 1rem;
  }

  .abstracts-copy__preview-link {
    margin-top: 1.25rem;
    padding: 1rem;
    border: var(--keyline);
    background: var(--vgzt-paper-strong);
    font-weight: 750;
  }

  .preferred-session-times {
    display: grid;
    margin: 1.2rem 0 2rem;
    padding: 0;
    border-top: var(--keyline);
    list-style: none;
  }

  .preferred-session-times li {
    display: grid;
    padding: 0.8rem 0;
    border-bottom: var(--keyline);
    grid-template-columns: minmax(8rem, 0.35fr) minmax(0, 1fr);
    gap: 0.8rem;
    align-items: start;
  }

  .preferred-session-times > li > span {
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .faq-list {
    border-top: var(--keyline);
  }

  .faq-list details {
    border-bottom: var(--keyline);
  }

  .faq-list summary {
    cursor: pointer;
    padding-block: 1rem;
    font-weight: 900;
  }

  .faq-list details p {
    margin: 0 0 1.25rem;
  }

  .abstracts-submit .section-heading {
    align-items: start;
  }

  .abstracts-submit .section-heading p {
    max-width: 26rem;
  }

  .abstracts-followup__inner {
    display: flex;
    gap: 2rem;
    align-items: end;
    justify-content: space-between;
  }

  .abstracts-followup h2 {
    margin-bottom: 1rem;
  }

  .abstracts-followup p:last-child {
    margin-bottom: 0;
  }

  .abstracts-contact p {
    max-width: 52rem;
  }

  .abstracts-contact a {
    font-weight: 850;
  }

  @media (max-width: 50rem) {
    .abstract-glance__heading {
      align-items: start;
      flex-direction: column;
    }

    .abstracts-grid {
      grid-template-columns: 1fr;
    }

    .abstracts-rail {
      position: static;
      max-height: none;
      padding: 0;
      overflow: visible;
    }

    .abstracts-followup__inner {
      align-items: start;
      flex-direction: column;
    }

    .seminar-format {
      grid-template-columns: 1fr;
    }

    .seminar-format div + div {
      border-top: var(--keyline);
      border-left: 0;
    }

    .preferred-session-times li {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-section-nav]')
    .forEach((navigation) => {
      const links = [
        ...navigation.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'),
      ];
      const targets = links
        .map((link) => document.getElementById(link.hash.slice(1)))
        .filter((target): target is HTMLElement => target !== null);
      const visibleTargets = new Set<HTMLElement>();

      const activate = (target: HTMLElement) => {
        links.forEach((link) => {
          if (link.hash === `#${target.id}`)
            link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      };

      const targetForHash = () => {
        if (location.hash === '#preferred-session-times')
          return document.getElementById('session-times');
        return targets.find((target) => `#${target.id}` === location.hash);
      };

      activate(targetForHash() ?? targets[0] ?? document.body);

      links.forEach((link) => {
        link.addEventListener('click', () => {
          const target = document.getElementById(link.hash.slice(1));
          if (target) activate(target);
        });
      });

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const target = entry.target as HTMLElement;
            if (entry.isIntersecting) visibleTargets.add(target);
            else visibleTargets.delete(target);
          });
          const active = [...visibleTargets].sort(
            (a, b) =>
              Math.abs(a.getBoundingClientRect().top - 104) -
              Math.abs(b.getBoundingClientRect().top - 104),
          )[0];
          if (active) activate(active);
        },
        {
          rootMargin: '-104px 0px -60% 0px',
          threshold: [0, 0.01],
        },
      );

      targets.forEach((target) => observer.observe(target));
      window.addEventListener('hashchange', () => {
        const target = targetForHash();
        if (target) activate(target);
      });
    });
</script>
