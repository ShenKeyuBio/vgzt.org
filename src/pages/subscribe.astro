---
import JoinForm from '../components/Forms/JoinForm.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getFooterSocial,
  getSiteSettings,
  getSocialSettings,
} from '../lib/site-data';

const site = getSiteSettings();
const social = getSocialSettings();
const joinEndpoint =
  site.contactEndpoint?.replace(/\/contact\/?$/, '/join') ?? null;
---

<BaseLayout
  title="Join VGZT"
  description="Request access to the VGZT Slack community and mailing list."
  email={site.publicEmail}
  social={getFooterSocial(social)}
  masterLogo={site.masterLogo}
>
  <header class="page-hero page-hero--pink">
    <div class="container">
      <p class="eyebrow">Join the community</p>
      <h1>Stay connected with VGZT.</h1>
      <p>
        One short form requests both VGZT Slack access and seminar updates by
        email.
      </p>
    </div>
  </header>

  <JoinForm
    endpoint={joinEndpoint}
    turnstileSiteKey={site.turnstileSiteKey}
    email={site.publicEmail}
  />
</BaseLayout>
