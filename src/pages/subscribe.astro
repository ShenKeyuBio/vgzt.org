---
import JoinForm from '../components/Forms/JoinForm.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getFooterSocial,
  getSiteSettings,
  getSocialSettings,
} from '../lib/site-data';

const site = getSiteSettings();
const social = getSocialSettings();
const joinEndpoint =
  site.contactEndpoint?.replace(/\/contact\/?$/, '/join') ?? null;
---

<BaseLayout
  title="Subscribe VGZT Talks"
  description="Choose VGZT Slack, seminar email updates, or both."
  email={site.publicEmail}
  social={getFooterSocial(social)}
  masterLogo={site.masterLogo}
>
  <header class="page-hero page-hero--pink">
    <div class="container">
      <p class="eyebrow">Subscribe VGZT Talks</p>
      <h1>Stay connected with VGZT.</h1>
      <p>
        Choose the channels that suit you, then continue directly to the
        relevant signup option.
      </p>
    </div>
  </header>

  <JoinForm
    endpoint={joinEndpoint}
    turnstileSiteKey={site.turnstileSiteKey}
    email={site.publicEmail}
    slackInviteUrl={social.slackInviteUrl}
    newsletterUrl={social.newsletterUrl}
    newsletterEmbedScriptUrl={social.newsletterEmbedScriptUrl}
    newsletterFormId={social.newsletterFormId}
  />
</BaseLayout>
