---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getFooterSocial,
  getSiteSettings,
  getSocialSettings,
} from '../lib/site-data';

const site = getSiteSettings();
const social = getSocialSettings();
---

<BaseLayout
  title="Privacy"
  description="Privacy information for the VGZT website, contact form, and subscription form."
  email={site.publicEmail}
  social={getFooterSocial(social)}
  masterLogo={site.masterLogo}
>
  <header class="page-hero page-hero--pink page--compact">
    <div class="container">
      <p class="eyebrow">Privacy</p>
      <h1>Only what the conversation needs.</h1>
      <p>
        This static website uses minimal client-side functionality and requests
        no location permission.
      </p>
    </div>
  </header>
  <section class="section page--compact">
    <div class="container prose">
      <h2>Website</h2>
      <p>
        The public VGZT website is generated as static files. Timezone display
        uses the browser’s standard timezone setting, or an override stored
        locally in that browser. This preference is not sent to VGZT.
      </p>

      <h2>Contact form</h2>
      <p>
        If you use the contact form, VGZT processes your name, email address,
        selected category, and message so organizers can reply. Cloudflare
        Turnstile supplies anti-abuse verification. The contact service may
        retain operational logs containing a request identifier and outcome, but
        it is designed not to log message content or email addresses.
      </p>

      <h2>Subscription form</h2>
      <p>
        If you use the subscription form, VGZT processes your full name,
        affiliation, email address, and selected services. Cloudflare Turnstile
        supplies anti-abuse verification. The subscription service may retain
        operational logs containing a request identifier and outcome, but it is
        designed not to log your submitted details.
      </p>

      <h2>Email and community services</h2>
      <p>
        If you select seminar email updates, VGZT sends these details to
        EmailOctopus to provide the mailing-list service; its privacy terms
        apply. If you select the VGZT Slack community, the site returns a
        protected invitation after verification. The site does not embed
        provider forms or tracking links.
      </p>

      <h2>Questions</h2>
      <p>
        Contact <a href={`mailto:${site.publicEmail}`}>{site.publicEmail}</a> with
        privacy questions or requests related to a message you submitted.
      </p>
    </div>
  </section>
</BaseLayout>
